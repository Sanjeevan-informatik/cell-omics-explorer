@import "tailwindcss";
@import "tw-animate-css";

:root {
  --background: #071019;
  --foreground: #f4f8fb;
  --card: #0c1722;
  --card-foreground: #f4f8fb;
  --popover: #101d29;
  --popover-foreground: #f4f8fb;
  --primary: #32d6a4;
  --primary-foreground: #04120d;
  --secondary: #162533;
  --secondary-foreground: #dce7ee;
  --muted: #14212d;
  --muted-foreground: #8fa1b0;
  --accent: #1a2b39;
  --accent-foreground: #f4f8fb;
  --destructive: #ff6b7d;
  --border: #20313f;
  --input: #2b3d4a;
  --ring: #32d6a4;
  --radius: 0.8rem;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --font-sans: "Aptos", "Segoe UI", Arial, sans-serif;
  --font-mono: "Cascadia Code", "SFMono-Regular", Consolas, monospace;
}

* { box-sizing: border-box; }
html { background: var(--background); scroll-behavior: smooth; }
body { margin: 0; background: var(--background); color: var(--foreground); font-family: var(--font-sans); }
button, textarea { font: inherit; }
.app-shell { min-height: 100vh; background: radial-gradient(circle at 48% -10%, rgba(50,214,164,.1), transparent 28%), #071019; }
.topbar { height: 68px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid #1c2b37; background: rgba(7,16,25,.92); backdrop-filter: blur(18px); position: sticky; top: 0; z-index: 20; }
.brand-lockup { display: flex; align-items: center; gap: 12px; }
.brand-mark { width: 38px; height: 38px; display: grid; place-items: center; color: #32d6a4; border: 1px solid #2d7863; background: #0b241d; border-radius: 11px; }
.brand-mark svg { width: 21px; }
.brand-lockup div { display: flex; align-items: baseline; gap: 9px; }
.brand-lockup strong { font-size: 1.02rem; letter-spacing: -.01em; }
.brand-lockup span { color: #7f92a2; font-size: .8rem; }
.topbar-actions, .input-actions, .analysis-actions { display: flex; align-items: center; gap: 8px; }
.engine-badge { height: 30px; border-color: #28404d; color: #b7c5ce; background: #0c1822; padding: 0 10px; }
.status-dot { width: 7px; height: 7px; border-radius: 50%; background: #32d6a4; box-shadow: 0 0 0 4px rgba(50,214,164,.1); }
.repo-link { display: inline-flex; align-items: center; gap: 7px; color: #a9bac5; font-size: .82rem; text-decoration: none; padding: 7px 10px; border-radius: 8px; }
.repo-link:hover { color: white; background: #13202b; }
.repo-link svg { width: 15px; }

.workspace { display: grid; grid-template-columns: 300px minmax(570px,1fr) 260px; min-height: calc(100vh - 112px); }
.input-rail, .insight-rail { padding: 26px 22px; background: #09131d; }
.input-rail { border-right: 1px solid #1c2b37; }
.insight-rail { border-left: 1px solid #1c2b37; }
.results-stage { min-width: 0; padding: 28px 30px 36px; }
.section-heading, .results-intro { display: flex; justify-content: space-between; align-items: flex-start; }
.section-heading h1, .section-heading h2, .results-intro h2 { margin: 3px 0 0; font-size: 1.28rem; letter-spacing: -.025em; }
.section-heading.compact svg { width: 17px; color: #32d6a4; }
.eyebrow { color: #5b9e8b; font-family: var(--font-mono); font-size: .69rem; letter-spacing: .13em; text-transform: uppercase; }
.helper-copy { margin: 14px 0; color: #8fa1b0; font-size: .82rem; line-height: 1.55; }
.sequence-input { min-height: 232px; max-height: 300px; resize: vertical; border-color: #243846; background: #07111a; color: #8ed9c2; font-family: var(--font-mono); font-size: .7rem; line-height: 1.55; box-shadow: inset 0 1px 18px rgba(0,0,0,.22); }
.sequence-input:focus-visible { border-color: #32d6a4; box-shadow: 0 0 0 3px rgba(50,214,164,.12); }
.input-actions { margin-top: 10px; }
.input-actions button { flex: 1; border-color: #2a3c49; color: #b6c4cd; }
.control-block { margin-top: 24px; padding-top: 21px; border-top: 1px solid #1d2c38; }
.control-block label { display: block; color: #d9e3e9; font-size: .8rem; font-weight: 600; margin-bottom: 9px; }
.control-block button { background: #0d1a24; border-color: #2a3d49; }
.control-block p { color: #6f8493; font-size: .72rem; line-height: 1.5; margin: 9px 1px 0; }
.error-message { margin-top: 14px; padding: 10px 11px; border: 1px solid rgba(255,107,125,.3); background: rgba(255,107,125,.08); color: #ff9cac; border-radius: 8px; font-size: .77rem; line-height: 1.45; }
.analyze-button { width: 100%; margin-top: 20px; background: #32d6a4; color: #052016; font-weight: 700; box-shadow: 0 8px 24px rgba(50,214,164,.12); }
.analyze-button:hover { background: #46e2b4; }
.privacy-note { display: flex; gap: 9px; margin-top: 17px; color: #657b89; font-size: .68rem; line-height: 1.45; }
.privacy-note svg { width: 16px; flex: 0 0 16px; color: #4f7c6f; }
.privacy-note strong { display: block; color: #91a4b0; font-size: .7rem; }
.spin { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.results-intro { align-items: center; margin-bottom: 20px; }
.analysis-actions > button, .icon-action { border: 0; background: transparent; color: #8094a1; cursor: pointer; }
.analysis-actions > button { display: flex; align-items: center; gap: 6px; padding: 7px 9px; border-radius: 7px; font-size: .72rem; }
.analysis-actions > button:hover { color: #dce9ee; background: #14222d; }
.analysis-actions svg { width: 14px; }
.analysis-state { display: flex; align-items: center; gap: 6px; color: #99aab5; font-size: .76rem; }
.analysis-state svg { width: 16px; color: #32d6a4; }
.analysis-state i { margin-left: 5px; padding-left: 11px; border-left: 1px solid #2a3a46; color: #6f8492; font-style: normal; }
.metrics-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; }
.metric-card { padding: 16px; background: linear-gradient(145deg,#0e1a25,#0a151f); border: 1px solid #1e303d; border-radius: 12px; }
.metric-card p { margin: 0 0 9px; color: #758a99; font-size: .72rem; }
.metric-card strong { display: block; color: #f3f8fa; font-size: 1.38rem; letter-spacing: -.035em; }
.metric-card span { display: block; margin-top: 3px; color: #5f7583; font-size: .67rem; }
.analysis-tabs { margin-top: 22px; }
.tabs-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1e2d39; }
.tabs-header [data-slot="tabs-list"] { height: 42px; }
.tabs-header [data-slot="tabs-trigger"] { color: #758b99; padding-inline: 14px; }
.tabs-header [data-slot="tabs-trigger"][data-state="active"] { color: #edf6f8; }
.tabs-header [data-slot="tabs-trigger"]::after { background: #32d6a4; }
.tab-count { border-radius: 99px; background: #1b2b37; color: #9eb0bb; padding: 1px 6px; font-size: .64rem; }
.dataset-id { color: #526977; font-family: var(--font-mono); font-size: .64rem; letter-spacing: .08em; }
.tab-panel { display: grid; grid-template-columns: 1.06fr .94fr; gap: 12px; padding-top: 14px; }
.visual-card { min-width: 0; background: #0b1620; border: 1px solid #1d2f3b; border-radius: 13px; overflow: hidden; }
.full-card { grid-column: 1/-1; }
.card-heading { display: flex; justify-content: space-between; align-items: flex-start; padding: 17px 18px 13px; border-bottom: 1px solid #172833; }
.card-heading h3 { margin: 0; font-size: .92rem; }
.card-heading p { margin: 5px 0 0; color: #697f8d; font-size: .7rem; }
.card-heading > span { color: #66818d; font-size: .67rem; }
.icon-action { padding: 3px; }
.icon-action:hover { color: #32d6a4; }
.icon-action svg { width: 16px; }
.composition-chart { padding: 17px 18px 20px; }
.chart-legend { display: flex; gap: 13px; justify-content: flex-end; margin-bottom: 16px; }
.chart-legend span { display: flex; align-items: center; gap: 5px; color: #718796; font-size: .65rem; }
.chart-legend i { width: 7px; height: 7px; border-radius: 2px; }
.composition-rows { display: grid; gap: 14px; }
.composition-row { display: grid; grid-template-columns: 100px 1fr 41px; align-items: center; gap: 9px; }
.sample-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #9aabb5; font-size: .68rem; }
.stacked-bar { display: flex; height: 12px; overflow: hidden; border-radius: 3px; background: #172733; }
.stacked-bar span { height: 100%; border-right: 1px solid rgba(5,17,25,.35); }
.gc-label { text-align: right; color: #8194a0; font-family: var(--font-mono); font-size: .65rem; }
.tree-wrap { padding: 4px 10px 0; }
.tree-wrap svg { display: block; width: 100%; height: 214px; }
.tree-branch { stroke: #4d8dff; stroke-width: 1.5; }
.tree-node { fill: #0b1620; stroke: #32d6a4; stroke-width: 1.5; }
.tree-wrap text { fill: #aebdc5; font-size: 12px; font-family: var(--font-sans); }
.newick-row { display: grid; grid-template-columns: auto 1fr; gap: 9px; align-items: center; margin: 0 16px 15px; padding: 9px 10px; border-radius: 7px; background: #07111a; }
.newick-row span { color: #58707f; font-size: .64rem; text-transform: uppercase; }
.newick-row code { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #759e91; font-size: .61rem; }

.variant-panel { padding: 4px 18px 18px; }
.variant-track { height: 126px; position: relative; margin: 18px 12px 9px; }
.track-axis { position: absolute; left: 0; right: 0; bottom: 25px; height: 1px; background: #31424f; }
.variant-marker { position: absolute; bottom: 26px; width: 7px; min-width: 7px; border: 0; padding: 0; transform: translateX(-50%); border-radius: 3px 3px 0 0; opacity: .9; cursor: pointer; transition: filter .2s,transform .2s; }
.variant-marker:hover, .variant-marker:focus-visible { filter: brightness(1.3); transform: translateX(-50%) scaleX(1.35); outline: none; }
.axis-start, .axis-end { position: absolute; bottom: 2px; color: #627986; font-family: var(--font-mono); font-size: .65rem; }
.axis-start { left: 0; } .axis-end { right: 0; }
.variant-table-wrap { overflow-x: auto; }
.variant-table { width: 100%; border-collapse: collapse; font-size: .72rem; }
.variant-table th { color: #647b89; font-weight: 500; text-align: left; padding: 10px; border-bottom: 1px solid #1e303c; }
.variant-table td { color: #9dadb6; padding: 10px; border-bottom: 1px solid #142630; }
.base-chip { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 6px; font-weight: 700; }
.empty-state { padding: 70px 20px; text-align: center; color: #708692; font-size: .8rem; }

.sequence-map { padding: 18px; }
.sequence-map-section { border: 1px solid #1b303d; background: #08131d; border-radius: 11px; overflow: hidden; }
.sequence-map-heading { min-height: 55px; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 11px 13px; border-bottom: 1px solid #172a35; }
.sequence-map-heading h4 { margin: 0; color: #dce7ec; font-size: .875rem; }
.sequence-map-heading p { margin: 4px 0 0; color: #6f8692; font-size: .75rem; }
.overview-actions { display: flex; align-items: center; gap: 12px; }
.overview-legend { display: flex; align-items: center; gap: 13px; color: #8296a1; font-size: .7rem; white-space: nowrap; }
.overview-legend span { display: flex; align-items: center; gap: 5px; }
.overview-legend i { display: inline-block; width: 11px; height: 8px; border-radius: 2px; }
.legend-variant { background: #f06d91; }
.legend-window { border: 1px solid rgba(255,255,255,.72); background: rgba(255,255,255,.06); }
.open-sequence-page { display: flex; align-items: center; gap: 6px; padding: 7px 9px; border: 1px solid #2c4a4b; border-radius: 7px; background: rgba(50,214,164,.07); color: #61dfb8; font-size: .72rem; white-space: nowrap; cursor: pointer; }
.open-sequence-page:hover { border-color: #3a7968; background: rgba(50,214,164,.12); color: #83edcd; }
.open-sequence-page svg { width: 14px; }
.sequence-overview-shell { width: 100%; padding: 12px 13px 0; }
.sequence-overview-canvas { display: block; max-width: 100%; border: 1px solid #213542; border-radius: 6px; cursor: crosshair; touch-action: none; }
.sequence-overview-canvas:focus-visible { outline: 2px solid #32d6a4; outline-offset: 3px; }
.overview-axis { display: flex; justify-content: space-between; padding: 4px 14px 10px; color: #536c79; font-family: var(--font-mono); font-size: .58rem; }

.position-inspector { display: grid; grid-template-columns: 1.25fr .72fr .72fr 1.7fr auto; align-items: stretch; gap: 1px; margin: 10px 0; border: 1px solid #1e3440; border-radius: 10px; overflow: hidden; background: #1e3440; }
.position-inspector > div { min-width: 0; background: #0b1822; padding: 11px 13px; }
.position-inspector span { display: block; color: #718895; font-size: .68rem; text-transform: uppercase; letter-spacing: .07em; }
.position-number { display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: 8px; }
.position-number > span { grid-column: 1/-1; }
.position-number strong { margin-top: 2px; color: #f2f8fa; font-family: var(--font-mono); font-size: 1.1rem; }
.position-number em { align-self: end; padding: 3px 6px; border-radius: 99px; background: #142630; color: #8296a1; font-size: .68rem; font-style: normal; }
.position-number em.is-variable { background: rgba(240,109,145,.12); color: #f58baa; }
.position-fact strong { display: block; margin-top: 4px; font-family: var(--font-mono); font-size: 1.05rem; }
.allele-counts > div { display: flex; gap: 7px; margin-top: 5px; }
.allele-counts b { display: flex; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: .7rem; }
.allele-counts i { display: grid; place-items: center; min-width: 17px; height: 17px; padding-inline: 3px; border-radius: 4px; background: #152733; color: #9cabb4; font-size: .56rem; font-style: normal; }
.position-nav { display: flex; align-items: center; gap: 5px; padding-inline: 9px!important; }
.position-nav button { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 1px solid #2a3f4b; border-radius: 7px; background: #101f2a; color: #9fb0b9; cursor: pointer; }
.position-nav button:hover:not(:disabled) { border-color: #398872; color: #4bddb2; }
.position-nav button:disabled { opacity: .35; cursor: default; }
.position-nav svg { width: 15px; }

.detail-map { overflow: hidden; }
.zoom-control { display: flex; align-items: center; padding: 3px; border: 1px solid #253a46; border-radius: 7px; background: #0b1923; }
.zoom-control button { padding: 6px 9px; border: 0; border-radius: 5px; background: transparent; color: #748b97; font-size: .7rem; cursor: pointer; }
.zoom-control button:hover { color: #c1cdd3; }
.zoom-control button.is-active { background: #1b2f3b; color: #51ddb4; box-shadow: inset 0 0 0 1px #2d4b46; }
.alignment-scroll { max-width: 100%; max-height: 430px; overflow: auto; background: #07121b; outline: none; scrollbar-color: #2a4a55 #0a1720; }
.alignment-scroll:focus-visible { box-shadow: inset 0 0 0 2px rgba(50,214,164,.65); }
.alignment-table { min-width: 100%; }
.alignment-row { display: flex; height: 37px; border-bottom: 1px solid #142630; }
.alignment-row-label { position: sticky; left: 0; z-index: 6; display: flex; flex: 0 0 148px; width: 148px; min-width: 148px; flex-direction: column; justify-content: center; overflow: hidden; padding: 0 12px; border-right: 1px solid #213541; background: #0b1923; color: #8397a2; box-shadow: 7px 0 12px rgba(3,11,17,.2); font-size: .7rem; }
.alignment-row-label b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #a8b8c0; font-size: .72rem; font-weight: 600; }
.alignment-row-label small { margin-top: 1px; color: #5f7784; font-size: .62rem; text-transform: uppercase; letter-spacing: .05em; }
.alignment-track { position: relative; flex: 0 0 auto; height: 36px; background: repeating-linear-gradient(90deg,transparent 0,transparent 27px,rgba(37,55,67,.15) 28px); }
.alignment-base { position: absolute; top: 0; bottom: 0; display: grid; place-items: center; padding: 0; border: 0; border-right: 1px solid rgba(29,49,61,.52); background: rgba(19,35,46,.3); font-family: var(--font-mono); font-size: .69rem; font-weight: 700; cursor: pointer; }
.alignment-base:hover { z-index: 2; background: #1c303b; box-shadow: inset 0 0 0 1px #4b6b78; }
.alignment-base.is-variant { background: rgba(240,109,145,.055); box-shadow: inset 0 -2px rgba(240,109,145,.78); }
.alignment-base.is-selected { z-index: 3; background: #233c48; box-shadow: inset 2px 0 #f4f8fb,inset -2px 0 #f4f8fb,inset 0 -2px #f4f8fb; }
.alignment-base.display-2d, .alignment-base.display-3d { padding: 3px; }
.base-structure-glyph { display: block; width: 100%; height: 100%; overflow: visible; }
.base-structure-glyph .glyph-bonds line { stroke: currentColor; stroke-width: .09; }
.base-structure-glyph.mode-3d { filter: drop-shadow(1px 2px 2px rgba(0,0,0,.5)); }
.unknown-base-glyph { color: #82919b; font-family: var(--font-mono); font-size: .7rem; }
.alignment-row.is-active-sample .alignment-row-label { background: #16302f; color: #5be0b6; box-shadow: inset 3px 0 #32d6a4,7px 0 12px rgba(3,11,17,.25); }
.ruler-row { position: sticky; top: 0; z-index: 8; height: 30px; border-bottom-color: #28404c; background: #0c1a24; }
.ruler-row .alignment-row-label { z-index: 10; height: 30px; color: #667e8b; font-family: var(--font-mono); font-size: .56rem; text-transform: uppercase; letter-spacing: .06em; }
.ruler-track { height: 29px; background: #0a1720; }
.ruler-track > span { position: absolute; inset-block: 0; display: grid; place-items: center; overflow: visible; color: #536d7a; font-family: var(--font-mono); font-size: .52rem; }
.ruler-track > span.is-selected { color: #f3f8fa; background: #1d3440; }
.consensus-row { height: 41px; border-bottom: 1px solid #31505a; }
.consensus-row .alignment-row-label { height: 40px; background: #10222c; }
.consensus-row .alignment-track { height: 40px; background: #0c1c25; }
.consensus-row .alignment-base { font-size: .75rem; }
.reference-row .alignment-row-label { background: #0c1d26; }
.alignment-footnote { display: flex; justify-content: space-between; gap: 16px; padding: 10px 12px; border-top: 1px solid #1b303b; color: #718895; font-size: .7rem; }
.alignment-footnote b { margin-left: 4px; font-family: var(--font-mono); }

.compound-panel { display: grid; grid-template-columns: minmax(320px,.9fr) minmax(330px,1.1fr); gap: 1px; margin: 10px 0; overflow: hidden; border: 1px solid #23404a; border-radius: 11px; background: #23404a; }
.compound-visual, .compound-details { min-width: 0; background: #0a1721; }
.compound-visual { display: grid; place-items: center; min-height: 285px; }
.compound-structure-2d { width: min(100%,430px); height: 260px; padding: 18px; }
.compound-bonds line { stroke: #8fa6b1; stroke-width: .085; stroke-linecap: round; }
.compound-atom circle { stroke: rgba(255,255,255,.5); stroke-width: .025; }
.compound-atom text { fill: #fff; font-family: var(--font-sans); font-size: .18px; font-weight: 700; text-anchor: middle; }
.compound-structure-3d { position: relative; width: 100%; min-width: 0; overflow: hidden; }
.compound-structure-3d canvas { display: block; width: 100%; height: 250px; cursor: grab; touch-action: none; }
.compound-structure-3d canvas:active { cursor: grabbing; }
.compound-structure-3d canvas:focus-visible { outline: 2px solid #32d6a4; outline-offset: -3px; }
.compound-structure-3d button { position: absolute; left: 12px; bottom: 10px; display: flex; align-items: center; gap: 6px; padding: 6px 8px; border: 1px solid #31505d; border-radius: 7px; background: rgba(7,18,27,.84); color: #b3c1c8; font-size: .72rem; cursor: pointer; }
.compound-structure-3d button:hover { border-color: #3b7c6c; color: #65e2bc; }
.compound-structure-3d button svg { width: 14px; }
.compound-structure-3d > span { position: absolute; right: 12px; bottom: 14px; color: #718793; font-size: .7rem; pointer-events: none; }
.compound-details { display: flex; flex-direction: column; justify-content: center; padding: 24px; }
.compound-title-row { display: flex; align-items: center; gap: 14px; }
.compound-symbol { display: grid; place-items: center; flex: 0 0 48px; height: 48px; border: 1px solid #386455; border-radius: 12px; background: rgba(50,214,164,.09); color: #49ddb0; font-family: var(--font-mono); font-size: 1.25rem; font-weight: 800; }
.compound-title-row h4 { margin: 4px 0 0; color: #ecf4f6; font-size: 1.15rem; }
.compound-title-row p { margin: 4px 0 0; color: #8095a0; font-size: .78rem; }
.compound-details dl { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; margin: 20px 0 0; overflow: hidden; border: 1px solid #203642; border-radius: 8px; background: #203642; }
.compound-details dl > div { min-width: 0; padding: 10px; background: #0c1b25; }
.compound-details dt { color: #718894; font-size: .7rem; }
.compound-details dd { margin: 5px 0 0; overflow: hidden; color: #d7e2e7; font-family: var(--font-mono); font-size: .76rem; text-overflow: ellipsis; }
.compound-details dd a { color: #52dcb2; }
.compound-details .smiles-fact { grid-column: 1/-1; }
.compound-details .smiles-fact dd { white-space: normal; word-break: break-all; }
.compound-note { margin: 12px 0 0; color: #728793; font-size: .72rem; line-height: 1.5; }
.compound-panel-empty { grid-template-columns: 120px 1fr; align-items: center; min-height: 118px; padding: 18px; background: #0a1721; }
.compound-panel-empty > div:first-child { display: grid; justify-items: center; gap: 6px; }
.compound-panel-empty > div:first-child strong { color: #93a2aa; font-family: var(--font-mono); font-size: 2rem; }
.compound-panel-empty h4 { margin: 0; font-size: .95rem; }
.compound-panel-empty p { margin: 6px 0 0; color: #7e939e; font-size: .8rem; }

.heatmap-scroll { overflow-x: auto; padding: 18px; }
.heatmap { display: grid; min-width: 520px; gap: 4px; align-items: stretch; }
.heatmap-column { text-align: center; color: #6e8390; font-size: .67rem; padding: 5px; }
.heatmap-label { display: flex; align-items: center; overflow: hidden; color: #91a3ae; font-size: .67rem; text-overflow: ellipsis; white-space: nowrap; }
.heatmap-cell { display: grid; place-items: center; min-height: 45px; color: #d7e4ea; border-radius: 5px; font-family: var(--font-mono); font-size: .63rem; }
.heatmap-cell.is-null { background: repeating-linear-gradient(135deg,#13232e,#13232e 4px,#0c1922 4px,#0c1922 8px); color: #597080; }

.quality-list { margin-top: 20px; border-top: 1px solid #1a2b36; }
.quality-list > div { display: flex; justify-content: space-between; align-items: center; padding: 13px 1px; border-bottom: 1px solid #172833; font-size: .74rem; }
.quality-list span { color: #768c9a; }
.quality-list strong { color: #bcc9d0; font-family: var(--font-mono); font-size: .7rem; }
.quality-list .positive { display: flex; align-items: center; gap: 5px; color: #5adfb5; font-family: var(--font-sans); }
.quality-list svg { width: 14px; }
.insight-card { margin-top: 22px; padding: 16px; border: 1px solid #284438; background: linear-gradient(145deg,rgba(50,214,164,.08),rgba(11,22,32,.7)); border-radius: 12px; }
.insight-card h3 { margin: 7px 0 8px; font-size: .9rem; }
.insight-card p { margin: 0; color: #81959f; font-size: .72rem; line-height: 1.55; }
.insight-card button { display: flex; align-items: center; gap: 4px; margin-top: 13px; padding: 0; background: none; border: 0; color: #4fe0b4; font-size: .71rem; cursor: pointer; }
.insight-card button svg { width: 14px; }
.method-card { margin-top: 22px; padding-top: 20px; border-top: 1px solid #1c2d38; }
.method-card ol { display: grid; gap: 13px; padding: 0; margin: 15px 0 0; list-style: none; }
.method-card li { display: flex; align-items: flex-start; gap: 10px; }
.method-card li > span { display: grid; place-items: center; flex: 0 0 24px; height: 24px; border: 1px solid #294337; border-radius: 50%; color: #4dc8a3; font-family: var(--font-mono); font-size: .62rem; }
.method-card strong { display: block; color: #aebdc5; font-size: .72rem; }
.method-card p { margin: 3px 0 0; color: #607785; font-size: .66rem; line-height: 1.4; }
.tech-stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 23px; }
.tech-stack span { padding: 5px 7px; border: 1px solid #203541; border-radius: 5px; color: #607b88; font-family: var(--font-mono); font-size: .57rem; }
footer { min-height: 44px; display: flex; align-items: center; gap: 18px; padding: 0 24px; border-top: 1px solid #192a35; color: #526a78; font-size: .67rem; }
footer span:first-child { color: #8294a0; } footer span:nth-child(2) { flex: 1; }
footer a { display: flex; align-items: center; gap: 6px; color: #6f8491; text-decoration: none; }
footer svg { width: 14px; }

.sequence-page-shell { min-height: 100vh; background: radial-gradient(circle at 50% -8%,rgba(50,214,164,.12),transparent 30%),#071019; }
.sequence-page-topbar { position: sticky; top: 0; z-index: 30; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 66px; padding: 0 24px; border-bottom: 1px solid #1c2b37; background: rgba(7,16,25,.94); backdrop-filter: blur(18px); }
.sequence-page-topbar > .engine-badge { justify-self: end; }
.sequence-back-link { display: inline-flex; align-items: center; gap: 8px; width: max-content; padding: 8px 10px; border-radius: 8px; color: #9eb0ba; font-size: .82rem; text-decoration: none; }
.sequence-back-link:hover { background: #13222c; color: #f0f7f9; }
.sequence-back-link svg { width: 16px; }
.sequence-page-brand { display: flex; align-items: center; gap: 10px; }
.sequence-page-brand > span { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid #2d7863; border-radius: 10px; background: #0b241d; color: #32d6a4; }
.sequence-page-brand svg { width: 19px; }
.sequence-page-brand div { display: grid; }
.sequence-page-brand strong { font-size: .92rem; }
.sequence-page-brand small { margin-top: 1px; color: #718693; font-size: .68rem; }
.sequence-page-content { width: min(1500px,100%); margin: 0 auto; padding: 28px 28px 44px; }
.sequence-page-intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
.sequence-page-intro h1 { margin: 4px 0 0; font-size: 1.65rem; letter-spacing: -.035em; }
.sequence-page-intro p { max-width: 680px; margin: 8px 0 0; color: #8ba0ac; font-size: .9rem; line-height: 1.5; }
.sequence-page-actions { display: flex; align-items: center; gap: 10px; }
.sequence-page-actions button { border-color: #2b414d; color: #adbdc5; }
.workspace-state { display: flex; align-items: center; gap: 6px; color: #86a097; font-size: .78rem; white-space: nowrap; }
.workspace-state svg { width: 16px; color: #32d6a4; }
.sequence-page-metrics { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; margin-top: 22px; overflow: hidden; border: 1px solid #20333f; border-radius: 11px; background: #20333f; }
.sequence-page-metrics > div { min-width: 0; padding: 13px 15px; background: #0c1923; }
.sequence-page-metrics span { display: block; color: #758b97; font-size: .72rem; }
.sequence-page-metrics strong { display: block; overflow: hidden; margin-top: 5px; color: #e9f1f4; font-size: .95rem; text-overflow: ellipsis; white-space: nowrap; }
.sequence-data-editor { margin-top: 12px; border: 1px solid #1d313d; border-radius: 11px; background: #0a1620; }
.sequence-data-editor summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 58px; padding: 10px 14px; cursor: pointer; list-style-position: inside; }
.sequence-data-editor summary > span:first-child { display: inline-flex; align-items: baseline; gap: 10px; }
.sequence-data-editor summary strong { color: #becbd1; font-size: .82rem; }
.sequence-data-editor summary small { color: #687f8c; font-size: .72rem; }
.editor-summary-action { padding: 6px 9px; border: 1px solid #2a414d; border-radius: 7px; color: #84a097; font-size: .72rem; white-space: nowrap; }
.sequence-data-editor[open] .editor-summary-action { border-color: #357160; color: #4eddb2; }
.sequence-editor-body { display: grid; grid-template-columns: minmax(0,1fr) 260px; gap: 16px; padding: 16px; border-top: 1px solid #1b2e39; }
.sequence-editor-input label, .sequence-editor-controls > label { display: block; margin-bottom: 8px; color: #a8b8c0; font-size: .78rem; font-weight: 600; }
.sequence-editor-input textarea { min-height: 210px; resize: vertical; border-color: #263c48; background: #07111a; color: #8ed9c2; font-family: var(--font-mono); font-size: .75rem; line-height: 1.55; }
.sequence-editor-controls { display: flex; flex-direction: column; gap: 9px; }
.sequence-editor-controls > button { justify-content: flex-start; }
.sequence-editor-controls .analyze-button { justify-content: center; margin-top: auto; }
.sequence-editor-controls .error-message { margin-top: 0; }
.molecule-mode-bar { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 12px; padding: 12px 14px; border: 1px solid #234039; border-radius: 11px; background: linear-gradient(120deg,rgba(50,214,164,.075),rgba(10,23,33,.9)); }
.molecule-mode-bar > div:first-child { display: grid; gap: 3px; }
.molecule-mode-bar strong { color: #cfdbdf; font-size: .82rem; }
.molecule-mode-bar small { color: #748b96; font-size: .72rem; }
.molecule-mode-switch { display: flex; align-items: center; gap: 3px; padding: 3px; border: 1px solid #29433f; border-radius: 8px; background: #08151e; }
.molecule-mode-switch button { padding: 8px 11px; border: 0; border-radius: 6px; background: transparent; color: #8397a2; font-size: .76rem; cursor: pointer; }
.molecule-mode-switch button:hover { color: #dbe6e9; }
.molecule-mode-switch button.is-active { background: #1b3737; color: #5be1b8; box-shadow: inset 0 0 0 1px #38685b; }
.standalone-map-card { margin-top: 12px; }
.standalone-map-card > .card-heading h2 { margin: 0; font-size: 1rem; }
.standalone-map-card > .card-heading p { font-size: .75rem; }
.standalone-map-card .alignment-scroll { max-height: min(58vh,610px); }

@media (max-width:1180px) {
  .workspace { grid-template-columns: 280px minmax(0,1fr); }
  .insight-rail { grid-column: 1/-1; border-left: 0; border-top: 1px solid #1c2b37; display: grid; grid-template-columns: repeat(3,1fr); gap: 22px; }
  .insight-rail > .section-heading { grid-column: 1/-1; }
  .quality-list, .insight-card, .method-card { margin-top: 0; }
  .tech-stack { grid-column: 1/-1; margin-top: 0; }
}
@media (max-width:840px) {
  .workspace { display: block; }
  .input-rail { border-right: 0; border-bottom: 1px solid #1c2b37; }
  .sequence-input { min-height: 180px; }
  .results-stage { padding: 24px 18px 30px; }
  .tab-panel { grid-template-columns: 1fr; }
  .metrics-grid { grid-template-columns: repeat(2,1fr); }
  .insight-rail { display: grid; grid-template-columns: 1fr 1fr; }
  .insight-rail > .section-heading, .tech-stack { grid-column: 1/-1; }
  .method-card { padding-top: 0; border-top: 0; }
  .position-inspector { grid-template-columns: repeat(3,1fr); }
  .allele-counts { grid-column: span 2; }
  .position-nav { justify-content: flex-end; }
  .compound-panel { grid-template-columns: 1fr; }
  .compound-visual { min-height: 250px; }
}
@media (max-width:760px) {
  .sequence-page-topbar { grid-template-columns: 1fr auto; padding-inline: 14px; }
  .sequence-page-topbar > .engine-badge { display: none; }
  .sequence-page-brand { justify-self: end; }
  .sequence-page-content { padding: 22px 14px 34px; }
  .sequence-page-intro { align-items: flex-start; flex-direction: column; gap: 14px; }
  .sequence-page-actions { width: 100%; justify-content: space-between; }
  .sequence-page-metrics { grid-template-columns: repeat(2,1fr); }
  .sequence-editor-body { grid-template-columns: 1fr; }
  .sequence-data-editor summary > span:first-child { align-items: flex-start; flex-direction: column; gap: 3px; }
  .sequence-editor-controls .analyze-button { margin-top: 6px; }
  .molecule-mode-bar { align-items: flex-start; flex-direction: column; }
  .molecule-mode-switch { width: 100%; }
  .molecule-mode-switch button { flex: 1; }
}
@media (max-width:560px) {
  .topbar { padding: 0 15px; }
  .brand-lockup div { display: block; }
  .brand-lockup span { display: block; margin-top: 1px; }
  .engine-badge { display: none; }
  .repo-link { font-size: 0; }
  .repo-link svg { width: 18px; }
  .input-rail { padding: 22px 16px; }
  .results-intro { align-items: flex-start; gap: 12px; }
  .analysis-actions { display: grid; justify-items: end; }
  .analysis-state i { display: none; }
  .metrics-grid { gap: 8px; }
  .metric-card { padding: 13px; }
  .metric-card strong { font-size: 1.12rem; }
  .dataset-id { display: none; }
  .tabs-header { overflow-x: auto; }
  .tabs-header [data-slot="tabs-list"] { min-width: max-content; }
  .tabs-header [data-slot="tabs-trigger"] { padding-inline: 9px; }
  .composition-row { grid-template-columns: 72px 1fr 39px; }
  .sequence-map { padding: 11px; }
  .sequence-map-heading { align-items: flex-start; flex-direction: column; gap: 9px; }
  .overview-actions { width: 100%; align-items: flex-start; flex-direction: column; }
  .overview-legend { width: 100%; justify-content: flex-start; }
  .open-sequence-page { width: 100%; justify-content: center; }
  .position-inspector { grid-template-columns: 1.2fr 1fr 1fr; }
  .allele-counts { grid-column: 1/-1; }
  .position-nav { grid-column: 1/-1; justify-content: flex-end; }
  .compound-details { padding: 17px; }
  .compound-details dl { grid-template-columns: 1fr 1fr; }
  .compound-details .smiles-fact { grid-column: 1/-1; }
  .compound-panel-empty { grid-template-columns: 70px 1fr; }
  .zoom-control { width: 100%; }
  .zoom-control button { flex: 1; }
  .alignment-row-label { flex-basis: 112px; width: 112px; min-width: 112px; padding-inline: 8px; }
  .alignment-footnote { align-items: flex-start; flex-direction: column; gap: 4px; }
  .insight-rail { display: block; padding: 24px 17px; }
  .insight-card, .method-card { margin-top: 22px; }
  .method-card { padding-top: 20px; border-top: 1px solid #1c2d38; }
  footer { flex-wrap: wrap; padding-block: 12px; gap: 6px 12px; }
  footer span:nth-child(2) { flex-basis: 100%; order: 3; }
  .sequence-back-link { padding-inline: 4px; font-size: .75rem; }
  .sequence-page-brand strong { font-size: .82rem; }
  .sequence-page-brand small { font-size: .62rem; }
  .sequence-page-actions { align-items: flex-start; flex-direction: column; }
  .sequence-page-actions button { width: 100%; }
  .molecule-mode-switch { flex-direction: column; }
  .molecule-mode-switch button { width: 100%; }
}
@media (prefers-reduced-motion:reduce) { * { scroll-behavior: auto!important; animation-duration: .01ms!important; } }

/* Hierarchical biology panel */
.hierarchy-panel {
  display: grid;
  gap: 1.2rem;
}

.hierarchy-hero .card-heading,
.sequence-structure-card .card-heading,
.hierarchy-node-detail .card-heading {
  align-items: flex-start;
}

.hierarchy-groups {
  display: grid;
  gap: 1rem;
}

.hierarchy-group-card {
  border: 1px solid rgba(123, 166, 219, 0.16);
  background: linear-gradient(180deg, rgba(10, 19, 29, 0.88), rgba(7, 14, 24, 0.95));
  border-radius: 1rem;
  padding: 1rem;
}

.hierarchy-group-title {
  display: flex;
  gap: 0.85rem;
  align-items: flex-start;
}

.hierarchy-group-title h4 {
  margin: 0;
  font-size: 1.02rem;
}

.hierarchy-group-title p,
.hierarchy-node-description,
.callout-list,
.hierarchy-node-detail li,
.structure-note-card li {
  color: #94a9c2;
}

.hierarchy-group-icon,
.hierarchy-node-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.4rem;
  height: 2.4rem;
  border-radius: 0.85rem;
  border: 1px solid rgba(123, 166, 219, 0.18);
  background: rgba(18, 33, 50, 0.8);
  color: #86bbff;
}

.hierarchy-node-grid {
  display: grid;
  gap: 0.8rem;
  grid-template-columns: repeat(auto-fit, minmax(158px, 1fr));
  margin-top: 0.95rem;
}

.hierarchy-node-button {
  appearance: none;
  border: 1px solid rgba(123, 166, 219, 0.18);
  background: linear-gradient(180deg, rgba(14, 28, 43, 0.95), rgba(9, 19, 31, 0.92));
  color: #edf5ff;
  border-radius: 1rem;
  padding: 0.95rem;
  text-align: left;
  display: grid;
  gap: 0.42rem;
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

.hierarchy-node-button:hover,
.hierarchy-node-button.is-selected {
  transform: translateY(-2px);
  border-color: rgba(95, 171, 255, 0.6);
  box-shadow: 0 10px 28px rgba(8, 20, 32, 0.35);
}

.hierarchy-node-button strong {
  font-size: 1rem;
}

.hierarchy-node-button small {
  color: #8fa8c7;
  line-height: 1.4;
}

.hierarchy-detail-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: 1.6fr 1fr;
}

.hierarchy-detail-columns {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 1rem;
}

.hierarchy-detail-columns h4,
.structure-note-card h4 {
  margin: 0 0 0.5rem;
  font-size: 0.95rem;
}

.hierarchy-detail-columns ul,
.callout-list,
.structure-note-card ul {
  margin: 0;
  padding-left: 1rem;
  display: grid;
  gap: 0.45rem;
}

.info-callout {
  background: linear-gradient(180deg, rgba(14, 24, 39, 0.92), rgba(8, 16, 27, 0.97));
}

.structure-summary-grid {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-bottom: 1rem;
}

.structure-summary-grid > div,
.structure-note-card {
  border-radius: 0.95rem;
  border: 1px solid rgba(123, 166, 219, 0.16);
  background: rgba(11, 21, 34, 0.75);
  padding: 0.9rem 1rem;
}

.structure-summary-grid span,
.structure-note-card p,
.structure-axis,
.structure-caption.secondary {
  color: #95aac6;
}

.structure-summary-grid strong {
  display: block;
  margin-top: 0.35rem;
  font-size: 1rem;
  color: #f3f7ff;
}

.dna-selector-grid {
  display: grid;
  grid-template-columns: repeat(10, minmax(0, 1fr));
  gap: 0.6rem;
  margin-bottom: 1rem;
}

.dna-base-button,
.mode-pill-row button,
.track-token {
  appearance: none;
  border: 1px solid rgba(123, 166, 219, 0.18);
  background: rgba(10, 21, 33, 0.92);
  color: #e8eef9;
  border-radius: 0.8rem;
}

.dna-base-button {
  min-height: 4rem;
  display: grid;
  gap: 0.15rem;
  justify-items: center;
  align-content: center;
}

.dna-base-button span {
  font-size: 0.76rem;
  color: #8fa8c7;
}

.dna-base-button strong {
  font-size: 1.12rem;
}

.dna-base-button.is-selected,
.mode-pill-row button.is-active,
.track-token.is-selected {
  border-color: rgba(95, 171, 255, 0.7);
  box-shadow: inset 0 0 0 1px rgba(95, 171, 255, 0.4);
  background: rgba(21, 42, 64, 0.95);
}

.mode-pill-row {
  display: inline-flex;
  gap: 0.45rem;
}

.mode-pill-row button {
  padding: 0.6rem 0.95rem;
}

.structure-2d-layout,
.structure-3d-layout {
  display: grid;
  gap: 1rem;
  grid-template-columns: 1.7fr 1fr;
}

.structure-flow-panel,
.structure-visual-stack {
  display: grid;
  gap: 0.85rem;
}

.track-row {
  display: grid;
  gap: 0.5rem;
}

.track-row > span {
  font-size: 0.8rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #8fa8c7;
}

.track-sequence {
  display: grid;
  gap: 0.4rem;
  grid-template-columns: repeat(30, minmax(0, 1fr));
}

.codon-track {
  grid-template-columns: repeat(10, minmax(0, 1fr));
}

.track-token {
  min-height: 2.5rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.92rem;
}

.track-token.wide {
  min-height: 2.9rem;
}

.track-token.is-rna {
  background: rgba(17, 49, 44, 0.9);
  color: #9ae8c8;
}

.track-token.is-aa,
.track-token.is-derived {
  background: rgba(61, 42, 18, 0.9);
  color: #ffd89b;
}

.track-token.is-protein {
  background: rgba(17, 32, 48, 0.92);
  color: #bddcff;
}

.track-token.is-derived {
  color: #ffcf8a;
}

.structure-svg {
  width: 100%;
  height: auto;
  border-radius: 1rem;
  border: 1px solid rgba(123, 166, 219, 0.16);
  background: radial-gradient(circle at top, rgba(18, 36, 58, 0.62), rgba(8, 15, 24, 0.95));
  padding: 0.5rem;
}

.helix-strand-a,
.helix-strand-b,
.helix-rung,
.structure-guide {
  fill: none;
  stroke-linecap: round;
}

.helix-strand-a {
  stroke: #7bb1ff;
  stroke-width: 4.5;
}

.helix-strand-b {
  stroke: #f08aa8;
  stroke-width: 4.5;
}

.helix-rung {
  stroke: rgba(194, 218, 250, 0.5);
  stroke-width: 2.5;
}

.helix-rung.is-selected,
.structure-guide {
  stroke: rgba(255, 214, 115, 0.9);
  stroke-width: 3;
}

.structure-caption {
  fill: #eef5ff;
  font-size: 12px;
  font-weight: 700;
}

.structure-text,
.structure-axis {
  fill: #d7e3f1;
  font-size: 10px;
  font-weight: 600;
}

.structure-text.is-selected {
  fill: #0b1622;
}

@media (max-width: 1120px) {
  .hierarchy-detail-grid,
  .structure-2d-layout,
  .structure-3d-layout {
    grid-template-columns: 1fr;
  }

  .hierarchy-detail-columns,
  .structure-summary-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .hierarchy-detail-columns,
  .structure-summary-grid,
  .dna-selector-grid {
    grid-template-columns: 1fr;
  }

  .track-sequence {
    grid-template-columns: repeat(10, minmax(0, 1fr));
  }

  .codon-track {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
}

/* Platform navigation is shared by both analysis and teaching workspaces. */
.platform-shell{display:grid;grid-template-columns:238px minmax(0,1fr);min-height:100vh;background:#07131b;color:#e9f4f8}.platform-navigation{position:sticky;top:0;height:100vh;overflow-y:auto;padding:24px 16px;border-right:1px solid #214252;background:#08151d}.platform-brand{display:block;font-size:25px;font-weight:750;color:#e9f4f8;text-decoration:none;padding:0 10px 20px}.platform-brand span{display:block;font-size:11px;font-weight:400;color:#8faab9;margin-top:5px}.platform-navigation nav section{margin-bottom:16px}.platform-navigation h2{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#90aab8;margin:0 10px 5px}.platform-navigation nav a{display:block;border-radius:7px;padding:7px 10px;font-size:12px;text-decoration:none;color:#c1d5df}.platform-navigation nav a:hover,.platform-navigation nav a[aria-current]{background:#163342;color:#74ead1}.platform-navigation a:focus-visible{outline:2px solid #74ead1;outline-offset:2px}.repository-link{display:block;color:#91bbcd;font-size:12px;padding:10px}.platform-content{min-width:0}.explorer-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px 28px;border-bottom:1px solid #214252}.explorer-heading h1{font-size:23px;margin:0 0 5px}.explorer-heading p{color:#9bb6c4;font-size:13px;margin:0;max-width:760px}.scope-badge{border:1px solid #826d35;color:#f0cd80;border-radius:20px;padding:6px 10px;font-size:11px;white-space:nowrap}.explorer-frame{display:block;width:100%;height:calc(100vh - 105px);min-height:600px;border:0;background:#07131b}.skip-content{position:fixed;top:-60px;left:20px;background:#74ead1;color:#07131b;padding:10px;z-index:100}.skip-content:focus{top:10px}@media(max-width:900px){.platform-shell{grid-template-columns:1fr}.platform-navigation{position:relative;height:auto;padding:12px}.platform-brand{font-size:20px;padding:0 6px 10px}.platform-navigation nav{display:flex;overflow-x:auto;gap:18px}.platform-navigation nav section{min-width:190px;margin-bottom:0}.platform-navigation nav a{white-space:nowrap}.repository-link{padding:5px}.explorer-heading{padding:18px;align-items:flex-start;flex-direction:column;gap:10px}.explorer-frame{height:80vh}}

/* Data upload, sample library, and missing-data states. */
.data-hub{max-width:1480px;margin:auto;padding:30px;color:#e8f2f7}.data-hub-header,.data-section-title,.data-preview-heading{display:flex;justify-content:space-between;align-items:center;gap:20px}.data-hub-header{margin-bottom:24px}.data-eyebrow{font-size:10px;letter-spacing:.12em;font-weight:700;color:#66dbc3}.data-hub h1{font-size:30px;letter-spacing:-.04em;margin:6px 0}.data-hub p{color:#9ab4c2;line-height:1.6}.data-summary{display:flex;align-items:center;gap:25px;padding:20px 24px;background:#102631;border:1px solid #25424f;border-radius:14px;margin-bottom:22px}.data-summary>div{min-width:95px}.data-summary strong{display:block;font-size:26px;color:#8debd9}.data-summary span{font-size:11px;color:#9ab4c2}.data-summary p{font-size:12px;max-width:480px;margin:0 0 0 auto}.data-upload-section{display:grid;grid-template-columns:minmax(220px,.65fr) minmax(0,1.35fr);gap:25px;margin-bottom:18px}.data-label{display:block;font-size:13px;font-weight:600;margin-bottom:12px}.data-hub select,.module-data select{display:block;width:100%;background:#102631;color:#e8f2f7;border:1px solid #365664;border-radius:9px;padding:12px;margin:10px 0}.data-help{font-size:12px!important;color:#94b0bd!important;line-height:1.6}.data-drop{display:flex;align-items:center;flex-direction:column;padding:25px 18px;border:1px dashed #578575;border-radius:14px;background:#102e30;text-align:center}.data-drop.dragging{background:#1c4a47;border-color:#99f5dc}.data-drop svg{color:#85ead2}.data-drop h2{font-size:18px;margin:10px 0 3px}.data-drop p{font-size:13px;margin:0 0 14px}.data-drop small{font-size:11px;color:#94b7b6;margin-top:15px}.data-notice{padding:14px 18px;background:#142d3a;border:1px solid #35596e;color:#cbe0ec;border-radius:10px;font-size:13px;margin:14px 0}.data-section-title{margin:26px 0 15px}.data-section-title h2{font-size:18px;margin:0}.data-empty{border:1px solid #294452;background:#0d222d;border-radius:14px;padding:35px;text-align:center;color:#99b8c8}.data-empty svg{margin:auto;color:#719fad}.data-empty h2,.data-empty h3{color:#e0edf5;margin:13px 0 8px}.data-empty p{font-size:13px;max-width:650px;margin:8px auto 18px;line-height:1.7}.data-file-list{border:1px solid #294452;border-radius:12px;overflow:hidden}.data-file-list article{display:flex;align-items:center;gap:10px;padding:12px;border-bottom:1px solid #243d4b;background:#0d222d}.data-file-list article.selected{background:#173541}.data-file-select{min-width:0;flex:1;display:flex;gap:12px;align-items:center;background:none;border:0;text-align:left;color:#dfeff7;cursor:pointer}.data-file-select svg{flex-shrink:0;color:#8bccba}.data-file-select span{min-width:0}.data-file-select strong{display:block;overflow-wrap:anywhere;font-size:13px}.data-file-select small{display:block;color:#98b8c8;font-size:11px;margin-top:4px}.data-status{white-space:nowrap;font-size:10px;border-radius:20px;padding:5px 9px;border:1px solid #47606c;color:#b5cedb}.data-status.ready{background:#103a30;color:#9ae5c3;border-color:#316e59}.data-status.invalid{background:#40232c;color:#f7b0b6;border-color:#82505d}.data-status.unsupported,.data-status.preview{background:#362f21;color:#e6cb93;border-color:#716041}.data-open{color:#91e4d1;text-decoration:none;font-size:12px}.data-preview{margin-top:18px;padding:20px;border:1px solid #335564;border-radius:12px;background:#0e202b}.data-preview h3{margin:0;font-size:17px;overflow-wrap:anywhere}.data-preview p{font-size:12px;line-height:1.6}.data-search{display:block;font-size:11px;color:#9cbbc8;max-width:400px;margin:14px 0}.data-search input{display:block;width:100%;border:1px solid #365363;background:#081821;color:#e5f2f8;padding:10px 12px;margin-top:5px;border-radius:8px}.data-table-wrap{overflow:auto;max-height:430px;border:1px solid #2b4655;border-radius:8px}.data-table-wrap table{width:100%;border-collapse:collapse;font-size:12px}.data-table-wrap th,.data-table-wrap td{text-align:left;padding:10px 12px;border-bottom:1px solid #243d4a;white-space:nowrap;max-width:500px;overflow:hidden;text-overflow:ellipsis}.data-table-wrap th{position:sticky;top:0;background:#15323e;color:#b4d7e6;font-size:11px}.missing-value{color:#e6c692;font-style:italic}.data-samples{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.data-samples article{display:flex;flex-direction:column;padding:20px;border:1px solid #2a4654;border-radius:12px;background:#0c212c}.data-samples h3{margin:10px 0 0;font-size:16px}.data-samples p{font-size:12px;min-height:40px}.data-samples code{display:block;color:#9bd2dc;font-size:11px;overflow-wrap:anywhere}.data-samples small{display:block;color:#96abb4;font-size:11px;margin:10px 0 18px}.data-samples article>div{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto}.data-samples a{display:flex;gap:6px;align-items:center;color:#b9d9e6;font-size:11px}.data-format-guide{padding:20px;border:1px solid #294757;border-radius:12px;margin-top:25px}.data-format-guide summary{cursor:pointer;color:#cee7f2;font-size:13px}.data-format-guide>div{border-bottom:1px solid #29424f;padding:15px 0;font-size:12px}.data-format-guide p{font-size:12px}.module-data{padding:0 26px 26px}.module-demo-notice{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:12px 25px;background:#302e20;color:#e6d6a5;font-size:12px}.data-hub :focus-visible,.module-data :focus-visible{outline:2px solid #7fe6d1;outline-offset:3px}@media(max-width:1150px){.data-samples{grid-template-columns:repeat(2,minmax(0,1fr))}.data-summary{gap:15px;flex-wrap:wrap}.data-summary p{margin:0;max-width:none}}@media(max-width:650px){.data-hub{padding:18px}.data-hub-header,.data-preview-heading{align-items:flex-start;flex-direction:column}.data-hub h1{font-size:25px}.data-upload-section,.data-samples{grid-template-columns:1fr}.data-file-list article{flex-wrap:wrap}.data-file-select{flex-basis:70%}.data-section-title{align-items:flex-start;flex-wrap:wrap}.data-preview{padding:12px}.module-data{padding:0 14px 20px}.module-demo-notice{flex-direction:column;align-items:flex-start}}

/* Unified Omics Atlas v3 — additive native React integration */
.atlas-page { width:min(1560px,100%); margin:0 auto; padding:26px 28px 56px; }
.atlas-hero { padding:24px; border:1px solid #223b47; border-radius:18px; background:radial-gradient(circle at 85% 0,rgba(50,214,164,.13),transparent 31%),linear-gradient(135deg,#0b1b25,#09151f 55%,#0a171f); box-shadow:0 24px 80px rgba(0,0,0,.2); }
.atlas-kicker,.atlas-eyebrow { display:inline-flex; align-items:center; gap:7px; color:#55ddb5; font-size:.7rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; }
.atlas-kicker svg,.atlas-eyebrow svg { width:14px; height:14px; }
.atlas-hero-row { display:flex; align-items:flex-start; justify-content:space-between; gap:28px; margin-top:10px; }
.atlas-hero h1 { margin:0; font-size:clamp(1.8rem,3vw,3rem); line-height:1.05; letter-spacing:-.05em; }
.atlas-hero-row p { max-width:880px; margin:12px 0 0; color:#91a6b2; font-size:.92rem; line-height:1.65; }
.atlas-health { display:grid; gap:8px; min-width:190px; padding:12px; border:1px solid #254136; border-radius:11px; background:#0a1b18; color:#9fb8af; font-size:.72rem; }
.atlas-health span { display:flex; align-items:center; gap:7px; }
.atlas-health i { width:7px; height:7px; border-radius:50%; background:#32d6a4; box-shadow:0 0 12px #32d6a4; }
.atlas-locus-bar { display:grid; grid-template-columns:110px 130px minmax(130px,1fr) minmax(130px,1fr) 150px auto; gap:9px; align-items:end; margin-top:22px; padding-top:18px; border-top:1px solid #1b313c; }
.atlas-locus-bar > div { min-width:0; }
.atlas-locus-bar label,.atlas-protein-controls label,.atlas-inline-control label { display:block; margin:0 0 5px; color:#718894; font-size:.65rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
.atlas-locus-bar input,.atlas-locus-bar select,.atlas-protein-controls input,.atlas-protein-controls select,.atlas-inline-control select { width:100%; min-height:38px; padding:7px 9px; border:1px solid #28404b; border-radius:8px; background:#07131c; color:#d4e1e5; font:inherit; font-size:.75rem; outline:none; }
.atlas-locus-bar input:focus,.atlas-locus-bar select:focus,.atlas-protein-controls input:focus,.atlas-protein-controls select:focus,.atlas-inline-control select:focus { border-color:#3c7e6c; box-shadow:0 0 0 2px rgba(50,214,164,.08); }
.atlas-locus-bar > button { min-height:38px; padding:0 13px; border:1px solid #347862; border-radius:8px; background:#12372d; color:#70e8c2; font-size:.72rem; font-weight:700; cursor:pointer; }
.atlas-locus-summary { display:flex; align-items:center; gap:9px; margin-top:13px; color:#839aa6; font-size:.74rem; }
.atlas-locus-summary svg { width:16px; color:#32d6a4; }.atlas-locus-summary strong { color:#dce7ea; }.atlas-locus-summary small { margin-left:auto; color:#5f7783; }
.atlas-layer-ribbon { display:grid; grid-template-columns:repeat(11,minmax(92px,1fr)); gap:6px; margin-top:12px; overflow-x:auto; padding-bottom:4px; }
.atlas-layer-ribbon button { min-width:98px; min-height:78px; display:grid; align-content:center; gap:2px; padding:9px; border:1px solid #1d3340; border-radius:10px; background:#091721; color:#6d8591; text-align:left; cursor:pointer; transition:.16s ease; }
.atlas-layer-ribbon button:hover { border-color:#31515c; transform:translateY(-1px); }.atlas-layer-ribbon button.active { border-color:#2e6d5b; background:linear-gradient(145deg,#102d27,#0b1c24); color:#a7c8bc; box-shadow:inset 0 0 0 1px rgba(50,214,164,.06); }
.atlas-layer-ribbon button > span { color:#49d5aa; font:700 .62rem var(--font-mono); }.atlas-layer-ribbon button strong { color:#c4d0d5; font-size:.67rem; line-height:1.25; }.atlas-layer-ribbon button small { color:#5e7581; font-size:.58rem; }
.atlas-tabs { position:sticky; top:0; z-index:20; display:flex; gap:4px; margin:16px 0 12px; overflow-x:auto; padding:5px; border:1px solid #1b313c; border-radius:11px; background:rgba(7,16,25,.92); backdrop-filter:blur(16px); }
.atlas-tabs button { display:inline-flex; align-items:center; gap:6px; min-height:34px; padding:7px 10px; border:0; border-radius:7px; background:transparent; color:#748a96; font-size:.72rem; white-space:nowrap; cursor:pointer; }.atlas-tabs button svg { width:14px; }.atlas-tabs button.active { background:#19352f; color:#60deb7; box-shadow:inset 0 0 0 1px #326253; }
.atlas-grid { display:grid; gap:12px; margin-top:12px; }.atlas-grid-2 { grid-template-columns:repeat(2,minmax(0,1fr)); }.atlas-span-2 { grid-column:1/-1; }
.atlas-card { min-width:0; overflow:hidden; border:1px solid #1e3541; border-radius:15px; background:linear-gradient(160deg,#0b1923,#09151e); box-shadow:0 13px 35px rgba(0,0,0,.12); }
.atlas-feature-card { margin-top:12px; }.atlas-card-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; padding:17px 18px 14px; border-bottom:1px solid #172c37; }.atlas-card-head h2 { margin:5px 0 0; color:#dce6e9; font-size:1rem; letter-spacing:-.02em; }.atlas-card-head p { max-width:760px; margin:5px 0 0; color:#728995; font-size:.72rem; line-height:1.5; }.atlas-card-head > a { color:#59d9b2; font-size:.68rem; text-decoration:none; white-space:nowrap; }
.atlas-track-stack { padding:18px; }.atlas-axis { display:flex; justify-content:space-between; margin:0 0 8px 162px; color:#536d79; font: .58rem var(--font-mono); }.atlas-track { display:grid; grid-template-columns:148px minmax(0,1fr); gap:14px; align-items:center; min-height:56px; border-top:1px solid #142832; }.atlas-track-label strong { display:block; color:#b3c2c9; font-size:.7rem; }.atlas-track-label small { display:block; margin-top:2px; color:#5e7682; font-size:.59rem; }.atlas-track-values { height:38px; display:flex; align-items:flex-end; gap:2px; padding:3px 0; }.atlas-track-values span { flex:1; min-width:3px; max-width:36px; border-radius:2px 2px 0 0; background:#315f64; opacity:.82; }.atlas-track-values span.is-hit { background:#d79a5d; box-shadow:0 0 8px rgba(215,154,93,.25); }
.atlas-gene-model { position:relative; height:46px; margin:8px 0 0 162px; display:flex; align-items:center; }.atlas-gene-model .exon { width:8%; height:15px; border:1px solid #44bb97; background:#1f6e59; border-radius:2px; z-index:2; }.atlas-gene-model .intron { width:9%; height:1px; background:#3b5965; }.atlas-gene-model .intron.wide { width:22%; }.atlas-gene-model b { position:absolute; left:0; top:31px; color:#5c7480; font-size:.58rem; font-weight:500; }
.atlas-hic-wrap { padding:18px; }.atlas-hic { display:grid; aspect-ratio:1; width:min(430px,100%); margin:auto; gap:2px; }.atlas-hic span { display:grid; place-items:center; border-radius:3px; background:#3ed0a6; color:#081612; font:600 .55rem var(--font-mono); }.atlas-scale { display:flex; align-items:center; justify-content:center; gap:9px; margin-top:10px; color:#5f7783; font-size:.58rem; }.atlas-scale i { width:90px; height:7px; border-radius:6px; background:linear-gradient(90deg,rgba(62,208,166,.15),rgba(62,208,166,1)); }
.atlas-signal-list { display:grid; gap:12px; padding:20px 18px 8px; }.atlas-signal-list > div { display:grid; grid-template-columns:94px 1fr 34px; gap:9px; align-items:center; color:#8297a1; font-size:.68rem; }.atlas-signal-list b { color:#b5c4ca; font: .64rem var(--font-mono); text-align:right; }.atlas-mini-bar { height:8px; overflow:hidden; border-radius:6px; background:#132731; }.atlas-mini-bar i { display:block; height:100%; border-radius:inherit; background:#3bc29b; }.atlas-note { margin:12px 18px 18px; padding:10px; border:1px solid #2a3a3f; border-radius:8px; color:#6f818a; background:#0b171e; font-size:.62rem; }
.atlas-cell-layout { display:grid; grid-template-columns:minmax(0,1fr) 190px; gap:16px; padding:18px; }.atlas-inline-control { display:flex; align-items:center; justify-content:flex-end; gap:8px; }.atlas-inline-control label { margin:0; }.atlas-inline-control select { width:130px; min-height:32px; }.atlas-cellplot { width:100%; min-height:260px; border:1px solid #172f3a; border-radius:10px; background:radial-gradient(circle at 50% 45%,#102733,#08151e 70%); }.atlas-cellplot line { stroke:#29414c; stroke-width:.4; }.atlas-cellplot text { fill:#536c78; font-size:3px; }.atlas-cellplot circle { stroke:#071019; stroke-width:.35; }.cluster-0 { fill:#5addb4; }.cluster-1 { fill:#72a8dd; }.cluster-2 { fill:#d89573; }.cluster-3 { fill:#b684d7; }.atlas-cluster-list { display:grid; align-content:center; gap:10px; }.atlas-cluster-list > div { display:flex; align-items:center; gap:9px; padding:9px; border:1px solid #17303a; border-radius:9px; background:#09161f; }.cluster-dot { flex:0 0 10px; height:10px; border-radius:50%; }.atlas-cluster-list strong { display:block; color:#b7c6cc; font-size:.68rem; }.atlas-cluster-list small { display:block; margin-top:2px; color:#5f7884; font-size:.57rem; }
.atlas-hierarchy { display:flex; align-items:center; justify-content:center; gap:8px; min-height:320px; padding:22px; overflow-x:auto; }.atlas-hierarchy > div { flex:0 0 108px; display:grid; justify-items:center; gap:4px; padding:13px 8px; border:1px solid #20413a; border-radius:12px; background:#0c201e; text-align:center; }.atlas-hierarchy > svg { flex:0 0 16px; width:16px; color:#3d665a; }.atlas-hierarchy div svg { width:20px; color:#52d8b0; }.atlas-hierarchy b { color:#c2cfd4; font-size:.68rem; }.atlas-hierarchy small { max-width:94px; overflow:hidden; color:#667d88; font-size:.56rem; text-overflow:ellipsis; white-space:nowrap; }
.atlas-oncoprint { padding:18px; overflow-x:auto; }.oncoprint-head,.oncoprint-row { display:grid; grid-template-columns:80px repeat(8,minmax(34px,1fr)); gap:3px; min-width:450px; }.oncoprint-head { margin-bottom:4px; }.oncoprint-head b { color:#5f7783; font:.58rem var(--font-mono); text-align:center; }.oncoprint-row { align-items:center; margin-bottom:3px; }.oncoprint-row strong { color:#9eafb7; font-size:.63rem; }.oncoprint-row > span { display:grid; place-items:center; height:27px; border-radius:3px; color:#06100e; font:700 .58rem var(--font-mono); }.alter-mut { background:#d88973 !important; }.alter-gain { background:#61b6d2 !important; }.alter-loss { background:#a783cf !important; }.alter-none { background:#152a34 !important; color:#49626d !important; }.oncoprint-legend { display:flex; flex-wrap:wrap; gap:12px; margin:13px 0 0 80px; color:#687f8a; font-size:.57rem; }.oncoprint-legend span { display:flex; align-items:center; gap:5px; }.oncoprint-legend i { width:9px; height:9px; border-radius:2px; }
.atlas-dataset-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; padding:16px; }.atlas-dataset-grid a { display:grid; grid-template-columns:38px 1fr 14px; gap:8px; align-items:center; padding:9px; border:1px solid #17303a; border-radius:8px; color:inherit; text-decoration:none; }.atlas-dataset-grid a:hover { border-color:#2d554d; background:#0c201e; }.atlas-dataset-grid a > span { color:#42d2a8; font:700 .6rem var(--font-mono); }.atlas-dataset-grid strong { display:block; color:#adbdc4; font-size:.64rem; }.atlas-dataset-grid small { display:block; margin-top:2px; color:#5d7480; font-size:.54rem; }.atlas-dataset-grid svg { width:13px; color:#496b63; }
.atlas-protein { padding:18px; }.atlas-protein-controls { display:grid; grid-template-columns:130px 130px 1fr; gap:10px; align-items:end; }.structure-switch { justify-self:end; display:flex; gap:3px; padding:3px; border:1px solid #25433c; border-radius:8px; background:#08151d; }.structure-switch button { min-width:48px; height:32px; border:0; border-radius:6px; background:transparent; color:#718994; font-size:.66rem; font-weight:700; cursor:pointer; }.structure-switch button.active { background:#193b33; color:#66dfb8; }
.residue-strip { display:grid; grid-template-columns:repeat(auto-fit,minmax(38px,1fr)); gap:4px; margin-top:13px; }.residue-strip button { position:relative; min-height:54px; display:grid; place-items:center; align-content:center; gap:2px; border:1px solid #1d3944; border-radius:7px; background:#0a1922; color:#b7c6cc; cursor:default; }.residue-strip button b { font:700 .88rem var(--font-mono); }.residue-strip button small { color:#5a7480; font:.53rem var(--font-mono); }.residue-strip button.modified { border-color:#856745; background:#241e16; color:#f0c98d; }.residue-strip button.modified i { position:absolute; right:5px; top:5px; width:6px; height:6px; border-radius:50%; background:#e0a95e; box-shadow:0 0 7px #e0a95e; }
.structure-stage { min-height:300px; margin-top:12px; display:grid; place-items:center; overflow:hidden; border:1px solid #1a3540; border-radius:12px; background:radial-gradient(circle at 50% 50%,#102a31,#07131b 70%); }.chemical-2d,.molecule-3d { width:100%; padding:16px; text-align:center; }.chemical-2d svg { width:min(700px,100%); max-height:240px; }.chemical-2d circle { fill:#102e31; stroke:#57c9a8; stroke-width:1.2; }.chemical-2d line { stroke:#688c8c; stroke-width:2; }.chemical-2d text { fill:#d4e3df; font:700 10px var(--font-mono); text-anchor:middle; }.chemical-2d .mod-bond { stroke:#d5a15f; stroke-dasharray:4 3; }.chemical-2d .mod-node { fill:#6f512f; stroke:#e0aa63; }.chemical-2d p,.molecule-3d p { margin:8px auto 0; max-width:720px; color:#607983; font-size:.62rem; }.molecule-3d svg { width:min(560px,92%); max-height:260px; filter:drop-shadow(0 18px 26px rgba(0,0,0,.25)); }.molecule-3d line { stroke:#496d70; stroke-width:1.2; }.molecule-3d circle { stroke:#b8d6cf; stroke-width:.3; }.atom-0 { fill:#5fe0b8; }.atom-1 { fill:#72aee3; }.atom-2 { fill:#d98d76; }.atom-3 { fill:#d0c36b; }.mode-4d .molecule-3d svg { animation:atlas-float 4s ease-in-out infinite; }.trajectory-control { display:flex; justify-content:center; align-items:center; gap:9px; margin:11px auto 0; color:#82979f; font-size:.62rem; }.trajectory-control input { width:min(340px,55%); accent-color:#32d6a4; }.trajectory-control span { min-width:24px; font: .6rem var(--font-mono); }.protein-facts { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }.protein-facts span { padding:8px 10px; border:1px solid #1c3440; border-radius:8px; background:#091720; color:#6e8590; font-size:.58rem; }.protein-facts b { color:#aebec5; }
@keyframes atlas-float { 0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-4px) rotate(.6deg)} }
.atlas-metabolome { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(320px,.8fr); gap:24px; padding:20px; }.spectrum-chart { position:relative; min-height:300px; padding:12px 10px 22px 32px; border-left:1px solid #29414c; border-bottom:1px solid #29414c; }.spectrum-bars { height:250px; display:flex; align-items:flex-end; justify-content:space-around; gap:4px; }.spectrum-bars > span { position:relative; width:2.2%; min-width:3px; max-width:11px; background:#55d7b0; border-radius:2px 2px 0 0; }.spectrum-bars i { position:absolute; top:-16px; left:50%; transform:translateX(-50%) rotate(-45deg); color:#77919b; font:normal .5rem var(--font-mono); }.spectrum-axis { position:absolute; color:#536d79; font:.55rem var(--font-mono); }.spectrum-axis.y { left:-7px; top:46%; transform:rotate(-90deg); }.spectrum-axis.x { right:5px; bottom:5px; }.metabolite-path { display:flex; align-items:center; justify-content:center; gap:8px; overflow-x:auto; }.metabolite-path > div { flex:0 0 112px; display:grid; justify-items:center; gap:5px; padding:14px 9px; border:1px solid #214138; border-radius:12px; background:#0b201d; text-align:center; }.metabolite-path > svg { flex:0 0 15px; width:15px; color:#396254; }.metabolite-path div svg { width:22px; color:#57d9b1; }.metabolite-path strong { color:#bac7cd; font-size:.65rem; }.metabolite-path small { color:#657c87; font-size:.54rem; }
.atlas-workflow { display:grid; gap:7px; padding:17px; }.workflow-step { display:grid; grid-template-columns:34px 1fr 16px; gap:9px; align-items:center; min-height:55px; padding:8px; border:1px solid #1a3440; border-radius:9px; background:#091720; }.workflow-step > span { display:grid; place-items:center; width:30px; height:30px; border:1px solid #2d6f5b; border-radius:50%; color:#58dbb2; font:.6rem var(--font-mono); }.workflow-step strong { display:block; color:#b6c4ca; font-size:.68rem; }.workflow-step small { display:block; margin-top:3px; color:#5e7581; font-size:.57rem; line-height:1.35; }.workflow-step > svg { width:14px; color:#37584f; }
.benchmark-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; padding:16px; }.benchmark-list > div { padding:10px; border:1px solid #18323c; border-radius:8px; background:#091720; }.benchmark-list strong { color:#62dcb6; font-size:.65rem; }.benchmark-list p { margin:4px 0 0; color:#657c87; font-size:.56rem; line-height:1.42; }
.atlas-preservation { display:flex; align-items:center; justify-content:space-between; gap:22px; margin-top:12px; padding:18px; border-color:#285342; background:linear-gradient(120deg,#0d2720,#0a1820); }.atlas-preservation > div:first-child { display:flex; align-items:flex-start; gap:12px; }.atlas-preservation svg { flex:0 0 22px; width:22px; color:#53dcb2; }.atlas-preservation h2 { margin:0; color:#cce0d9; font-size:.9rem; }.atlas-preservation p { max-width:780px; margin:5px 0 0; color:#759087; font-size:.64rem; line-height:1.5; }.preservation-links { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:6px; }.preservation-links a { padding:7px 9px; border:1px solid #2c594b; border-radius:7px; color:#65dcb6; font-size:.6rem; text-decoration:none; white-space:nowrap; }
@media(max-width:1180px){.atlas-layer-ribbon{grid-template-columns:repeat(6,minmax(110px,1fr))}.atlas-locus-bar{grid-template-columns:repeat(3,1fr)}.atlas-grid-2{grid-template-columns:1fr}.atlas-span-2{grid-column:auto}.atlas-metabolome{grid-template-columns:1fr}.atlas-card-head{flex-direction:column;gap:7px}}
@media(max-width:760px){.atlas-page{padding:14px 12px 38px}.atlas-hero{padding:16px}.atlas-hero-row{display:block}.atlas-health{margin-top:14px}.atlas-locus-bar{grid-template-columns:repeat(2,1fr)}.atlas-locus-summary{flex-wrap:wrap}.atlas-locus-summary small{margin-left:0;width:100%}.atlas-layer-ribbon{grid-template-columns:repeat(11,110px)}.atlas-track{grid-template-columns:90px 1fr;gap:8px}.atlas-axis,.atlas-gene-model{margin-left:98px}.atlas-cell-layout{grid-template-columns:1fr}.atlas-cluster-list{grid-template-columns:repeat(2,1fr)}.atlas-hierarchy{justify-content:flex-start}.atlas-dataset-grid{grid-template-columns:1fr}.atlas-protein-controls{grid-template-columns:1fr 1fr}.structure-switch{grid-column:1/-1;justify-self:start}.atlas-metabolome{padding:14px}.metabolite-path{justify-content:flex-start}.benchmark-list{grid-template-columns:1fr}.atlas-preservation{align-items:flex-start;flex-direction:column}.preservation-links{justify-content:flex-start}}

/* v5 metabolome chemical-structure workbench: one data-driven viewer for small molecules, lipids and glycan building blocks. */
.metabolome-structure-explorer{margin:20px 28px 24px;border:1px solid #24434b;border-radius:16px;background:linear-gradient(145deg,#091920,#08141c);overflow:hidden;color:#dce9ed}.chem-explorer-header{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:20px 22px;border-bottom:1px solid #19343d;background:linear-gradient(120deg,rgba(24,67,61,.55),rgba(8,20,28,.3))}.chem-explorer-header h2{margin:4px 0 5px;font-size:20px;letter-spacing:-.025em}.chem-explorer-header p{max-width:850px;margin:0;color:#8ea6af;font-size:12px;line-height:1.55}.chem-library-badge{flex:0 0 auto;padding:8px 10px;border:1px solid #315e51;border-radius:999px;color:#79dfbd;background:#0b241f;font-size:10px;white-space:nowrap}.chem-filter-bar{display:grid;grid-template-columns:minmax(220px,1.5fr) minmax(160px,.8fr) 130px 130px;gap:10px;padding:13px 16px;border-bottom:1px solid #18313a;background:#08161e}.chem-filter-bar label>span{display:flex;align-items:center;gap:5px;margin-bottom:5px;color:#718b96;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.06em}.chem-filter-bar input,.chem-filter-bar select{width:100%;min-height:36px;padding:7px 9px;border:1px solid #28434e;border-radius:8px;background:#07131a;color:#d7e5e8;font:inherit;font-size:11px;outline:none}.chem-filter-bar input:focus,.chem-filter-bar select:focus{border-color:#43a087;box-shadow:0 0 0 2px rgba(80,219,178,.08)}
.chem-browser-layout{display:grid;grid-template-columns:285px minmax(0,1fr);min-height:620px}.chem-compound-list{max-height:760px;overflow:auto;padding:10px;border-right:1px solid #18333c;background:#07141b}.chem-list-summary{display:flex;align-items:baseline;gap:7px;padding:8px 8px 11px;color:#728a94}.chem-list-summary b{font-size:17px;color:#65dab5}.chem-list-summary span{font-size:9px}.chem-compound-list>button{position:relative;width:100%;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px;align-items:center;margin-bottom:5px;padding:10px;border:1px solid #19313a;border-radius:9px;background:#091a22;color:#b7c7cd;text-align:left;cursor:pointer}.chem-compound-list>button:hover{border-color:#2b5e50;background:#0c211f}.chem-compound-list>button.active{border-color:#3f8f78;background:#102b27;box-shadow:inset 2px 0 #56d6ad}.chem-compound-list button strong{display:block;font-size:11px}.chem-compound-list button small{display:block;margin-top:3px;color:#667f8a;font-size:8.5px;line-height:1.35}.chem-compound-list button i{font:normal 9px var(--font-mono);color:#75929b;white-space:nowrap}.chem-compound-list button em{grid-column:1/-1;justify-self:start;padding:2px 5px;border-radius:4px;background:#184638;color:#75e1ba;font:normal 8px var(--font-mono)}.chem-compound-list>p{padding:14px;color:#78909a;font-size:10px}
.chem-workbench{min-width:0}.chem-compound-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:17px 19px 12px}.chem-compound-heading>div:first-child>span{color:#57d3ab;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.chem-compound-heading h3{margin:3px 0 4px;font-size:18px}.chem-compound-heading p{max-width:760px;margin:0;color:#7c969f;font-size:10.5px;line-height:1.5}.chem-formula{text-align:right}.chem-formula b{display:block;color:#d5e7e1;font:700 15px var(--font-mono)}.chem-formula small{display:block;margin-top:3px;color:#70858f;font:9px var(--font-mono)}
.chem-view-tabs{display:flex;gap:4px;padding:0 17px 10px;overflow-x:auto}.chem-view-tabs button{display:flex;align-items:center;gap:5px;min-height:33px;padding:7px 9px;border:1px solid #203b44;border-radius:8px;background:#091720;color:#758b95;font-size:9px;font-weight:650;white-space:nowrap;cursor:pointer}.chem-view-tabs button:hover{border-color:#356356;color:#9bbab2}.chem-view-tabs button.active{border-color:#3b8872;background:#15352d;color:#65dbb5}.chem-representation-note{display:flex;gap:8px;align-items:baseline;margin:0 17px 10px;padding:8px 10px;border-left:2px solid #326e5d;background:#0a1d1e}.chem-representation-note strong{color:#72dcb9;font-size:9px}.chem-representation-note span{color:#6d858e;font-size:9px;line-height:1.4}
.chem-structure-controls{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin:0 17px 9px;padding:8px 10px;border:1px solid #19323b;border-radius:9px;background:#08151c}.chem-structure-controls>label{display:flex;align-items:center;gap:6px;color:#78909a;font-size:9px}.chem-structure-controls input[type=range]{width:130px;accent-color:#50d7ae}.chem-structure-controls label>span{min-width:32px;color:#abc0c5;font:9px var(--font-mono)}.chem-checkbox input{accent-color:#50d7ae}.chem-frame-control{display:flex;align-items:center;gap:8px;margin-left:auto}.chem-frame-control button{display:flex;align-items:center;gap:4px;padding:6px 8px;border:1px solid #2b6655;border-radius:6px;background:#123329;color:#70dfbb;font-size:9px;cursor:pointer}.chem-frame-control button:disabled{opacity:.35;cursor:not-allowed}.chem-frame-control label{display:flex;align-items:center;gap:6px;color:#78909a;font-size:9px}.chem-frame-control input{accent-color:#50d7ae}
.chem-stage{position:relative;min-height:420px;margin:0 17px;display:grid;place-items:center;overflow:hidden;border:1px solid #17323b;border-radius:12px;background:radial-gradient(circle at 50% 45%,#102b31,#07131b 70%)}.chem-structure-svg{display:block;width:min(800px,95%);height:400px;overflow:visible}.chem-structure-svg line{stroke:#638387;stroke-linecap:round}.chem-structure-svg .aromatic-bond{stroke-dasharray:2 2}.chem-atom{cursor:pointer;outline:none}.chem-atom circle{stroke:#d2e3df;stroke-width:.25;filter:drop-shadow(0 1px 1px rgba(0,0,0,.25))}.chem-atom:hover circle,.chem-atom:focus circle{stroke:#fff;stroke-width:.8}.chem-atom text{pointer-events:none;fill:#07131b;font:700 2.4px var(--font-mono);text-anchor:middle}.chem-structure-3d text{font-size:2.1px}.chem-structure-svg .element-c{fill:#7f9aa3}.chem-structure-svg .element-h{fill:#e8f0f2}.chem-structure-svg .element-o{fill:#eb7f72}.chem-structure-svg .element-n{fill:#6ea8e8}.chem-structure-svg .element-p{fill:#e5ad5e}.chem-structure-svg .element-s{fill:#d7ce68}.chem-structure-svg .element-f,.chem-structure-svg .element-cl{fill:#66d190}.chem-structure-svg .element-br,.chem-structure-svg .element-i{fill:#b884d6}.chem-structure-svg .element-other{fill:#d6a7d2}.chem-science-warning{position:absolute;left:14px;right:14px;bottom:10px;padding:7px 9px;border:1px solid #5d4e2a;border-radius:7px;background:rgba(43,35,15,.92);color:#d5bb76;font-size:8.5px;text-align:center}
.chem-identity-panel{width:100%;align-self:stretch;padding:18px}.chem-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.chem-metrics span{padding:11px;border:1px solid #1b3640;border-radius:9px;background:#091920}.chem-metrics b{display:block;color:#c6d7db;font:700 12px var(--font-mono)}.chem-metrics small{display:block;margin-top:4px;color:#627b85;font-size:8px;text-transform:uppercase}.chem-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}.chem-detail-grid>div{padding:12px;border:1px solid #19323c;border-radius:9px;background:#091820}.chem-detail-grid h4,.chem-ion-layout h4,.chem-capability-details h3{margin:0 0 7px;color:#8ca5ad;font-size:9px;text-transform:uppercase;letter-spacing:.06em}.chem-detail-grid code{display:block;overflow:auto;color:#66d9b4;font:9px/1.45 var(--font-mono);white-space:nowrap}.chem-detail-grid p{margin:0;color:#88a0a8;font-size:9px;line-height:1.45}.chem-chip-row{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}.chem-chip-row span{padding:5px 7px;border:1px solid #27453d;border-radius:999px;background:#0d241f;color:#78baa5;font-size:8px}.chem-element-counts{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}.chem-element-counts span{display:flex;align-items:center;gap:4px;padding:5px 7px;border:1px solid #253944;border-radius:6px;background:#0a161e;color:#708993;font:8px var(--font-mono)}.chem-element-counts b{color:#c2d4d8}
.chem-ion-layout{width:100%;align-self:stretch;display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:18px}.chem-ion-layout>div{padding:14px;border:1px solid #1a3540;border-radius:10px;background:#091820}.chem-adduct-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.chem-adduct-grid span{display:grid;grid-template-columns:1fr auto;gap:2px 7px;padding:8px;border:1px solid #1d3a3f;border-radius:7px;background:#0b2020}.chem-adduct-grid b{color:#6fddb9;font-size:9px}.chem-adduct-grid code{color:#c0d1d5;font:9px var(--font-mono)}.chem-adduct-grid small{grid-column:1/-1;color:#657e88;font-size:7.5px}.chem-isotope-chart{height:240px;display:flex;align-items:flex-end;justify-content:center;gap:24px;padding:20px 10px 30px;border-left:1px solid #28414b;border-bottom:1px solid #28414b}.chem-isotope-chart>span{position:relative;width:17px;min-height:3px;background:#57d8b1;border-radius:2px 2px 0 0}.chem-isotope-chart i{position:absolute;bottom:-18px;left:50%;transform:translateX(-50%);color:#a9bdc2;font:normal 8px var(--font-mono)}.chem-isotope-chart small{position:absolute;top:-16px;left:50%;transform:translateX(-50%) rotate(-35deg);color:#6b838c;font:7px var(--font-mono);white-space:nowrap}.chem-ion-layout p{color:#677f89;font-size:8px;line-height:1.4}
.chem-spectrum-panel{width:100%;align-self:stretch;padding:20px}.chem-spectrum-bars{height:300px;display:flex;align-items:flex-end;justify-content:space-around;gap:5px;padding:20px 18px 0;border-left:1px solid #29414c;border-bottom:1px solid #29414c}.chem-spectrum-bars>span{position:relative;width:8px;max-width:2.5%;background:#55d7b0;border-radius:2px 2px 0 0}.chem-spectrum-bars i{position:absolute;top:-16px;left:50%;transform:translateX(-50%) rotate(-45deg);color:#7f98a1;font:normal 7px var(--font-mono)}.chem-spectrum-axis{display:flex;justify-content:space-between;padding:5px 18px 0 4px;color:#5c7781;font:8px var(--font-mono)}.chem-spectrum-panel p{max-width:720px;margin:12px auto 0;color:#687f89;font-size:9px;line-height:1.45;text-align:center}
.chem-pathway-panel{width:100%;align-self:stretch;padding:22px}.chem-pathway-chain{min-height:280px;display:flex;align-items:center;justify-content:center;gap:10px;overflow-x:auto}.chem-pathway-chain>div{flex:0 0 145px;min-height:100px;display:grid;place-items:center;align-content:center;gap:5px;padding:12px;border:1px solid #255145;border-radius:11px;background:#0d2621;text-align:center}.chem-pathway-chain>div svg{width:20px;color:#59d9b1}.chem-pathway-chain>div b{color:#bed0cc;font-size:9px}.chem-pathway-chain>div small{color:#667f88;font-size:8px}.chem-pathway-chain>span{color:#396256}.chem-pathway-panel>p{max-width:820px;margin:0 auto;color:#6f878f;font-size:9px;line-height:1.5;text-align:center}
.chem-detail-footer{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;padding:10px 17px 16px}.chem-detail-footer>div{padding:8px 9px;border:1px solid #182f38;border-radius:8px;background:#08161d}.chem-detail-footer strong{display:block;color:#8da5ad;font-size:8px;text-transform:uppercase}.chem-detail-footer span{display:block;margin-top:3px;color:#657e88;font-size:8.5px;line-height:1.4}.chem-capability-details{margin:0;border-top:1px solid #19353e;background:#07151c;padding:0 18px 16px}.chem-capability-details summary{padding:13px 0;color:#75d8b8;font-size:10px;cursor:pointer}.chem-capability-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.chem-capability-grid>div{padding:11px;border:1px solid #19323b;border-radius:9px;background:#091820}.chem-capability-grid p{display:grid;grid-template-columns:120px 1fr;gap:8px;margin:5px 0}.chem-capability-grid b{color:#aac0c4;font-size:8.5px}.chem-capability-grid span,.chem-capability-details li{color:#687f89;font-size:8.5px;line-height:1.45}.chem-capability-details ul{columns:2;column-gap:28px;margin:6px 0;padding-left:18px}.chem-capability-details li{margin-bottom:5px;break-inside:avoid}
.metabolome-structure-explorer.compact{margin:0;border:0;border-radius:0;background:transparent}.metabolome-structure-explorer.compact .chem-explorer-header,.metabolome-structure-explorer.compact .chem-filter-bar,.metabolome-structure-explorer.compact .chem-capability-details{display:none}.metabolome-structure-explorer.compact .chem-browser-layout{grid-template-columns:220px minmax(0,1fr);min-height:540px}.metabolome-structure-explorer.compact .chem-compound-list{max-height:600px}.metabolome-structure-explorer.compact .chem-stage{min-height:360px}.metabolome-structure-explorer.compact .chem-structure-svg{height:340px}.metabolome-structure-explorer.compact .chem-detail-footer{grid-template-columns:1fr 1fr}.metabolome-structure-explorer.compact .chem-detail-footer>div:last-child{grid-column:1/-1}
@media(max-width:1050px){.chem-filter-bar{grid-template-columns:1fr 1fr}.chem-browser-layout,.metabolome-structure-explorer.compact .chem-browser-layout{grid-template-columns:1fr}.chem-compound-list{display:flex;max-height:none;overflow-x:auto;border-right:0;border-bottom:1px solid #18333c}.chem-list-summary{flex:0 0 140px}.chem-compound-list>button{flex:0 0 220px;margin:0 5px 0 0}.chem-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.chem-detail-footer{grid-template-columns:1fr}.chem-ion-layout{grid-template-columns:1fr}.chem-capability-grid{grid-template-columns:1fr}.chem-capability-details ul{columns:1}}
@media(max-width:760px){.metabolome-structure-explorer{margin:12px}.chem-explorer-header{display:block;padding:15px}.chem-library-badge{display:inline-block;margin-top:10px}.chem-filter-bar{grid-template-columns:1fr;padding:10px}.chem-compound-heading{display:block}.chem-formula{text-align:left;margin-top:8px}.chem-view-tabs{padding-left:12px;padding-right:12px}.chem-representation-note,.chem-stage,.chem-structure-controls{margin-left:12px;margin-right:12px}.chem-structure-controls{align-items:flex-start;flex-direction:column}.chem-structure-controls>label{width:100%}.chem-structure-controls input[type=range]{flex:1}.chem-frame-control{width:100%;margin-left:0}.chem-frame-control label{flex:1}.chem-frame-control input{flex:1}.chem-stage{min-height:350px}.chem-structure-svg{height:330px;width:100%}.chem-metrics{grid-template-columns:1fr 1fr}.chem-detail-grid{grid-template-columns:1fr}.chem-detail-footer{padding-left:12px;padding-right:12px}.chem-pathway-chain{justify-content:flex-start}.chem-capability-grid p{grid-template-columns:1fr}.metabolome-structure-explorer.compact .chem-detail-footer{grid-template-columns:1fr}.metabolome-structure-explorer.compact .chem-detail-footer>div:last-child{grid-column:auto}}
