"use client";

import { useEffect, useMemo, useState } from 'react';
import { Atom, Boxes, CircleDot, FlaskConical, Layers3, Network, Pause, Play, ScanSearch, Search } from 'lucide-react';
import {
  METABOLITE_STRUCTURES,
  METABOLOME_IMPORT_FORMATS,
  METABOLOME_REPRESENTATIONS,
  METABOLOME_SCIENTIFIC_BOUNDARIES,
  type ChemicalAtom3D,
  type ChemicalViewMode,
  type MetaboliteStructure,
} from '@/lib/metabolome-structures';
import { SPECTRUM } from '@/lib/unified-omics';

const VIEW_ICONS: Record<ChemicalViewMode, typeof Atom> = {
  '1d': CircleDot,
  '2d': Atom,
  '3d': Boxes,
  '4d': Layers3,
  ions: FlaskConical,
  msms: ScanSearch,
  pathway: Network,
};

const VIEW_LABELS: Record<ChemicalViewMode, string> = {
  '1d': '1D identity',
  '2d': '2D chemistry',
  '3d': '3D conformer',
  '4d': '4D ensemble',
  ions: 'Ions & isotopes',
  msms: 'MS/MS',
  pathway: 'Pathway',
};

const ELEMENT_CLASS: Record<string,string> = {
  C:'element-c', H:'element-h', O:'element-o', N:'element-n', P:'element-p', S:'element-s', F:'element-f', Cl:'element-cl', Br:'element-br', I:'element-i',
};

function candidateSet(candidates: string[]) {
  return new Set(candidates.map(value=>value.trim().toLowerCase()).filter(Boolean));
}

function bondStrokeWidth(order: number) {
  return order >= 2.5 ? 2.6 : order >= 1.8 ? 2.1 : order > 1 ? 1.6 : 1.15;
}

function Structure2D({compound,zoom,onSelect}:{compound:MetaboliteStructure;zoom:number;onSelect:(atom:number)=>void}) {
  const atoms = compound.structure_2d.atoms;
  const byId = new Map(atoms.map(atom=>[atom.id,atom]));
  const dense = atoms.length > 28;
  return <svg className="chem-structure-svg" viewBox="0 0 100 100" role="img" aria-label={`${compound.name} 2D chemical structure`}>
    <g transform={`translate(${50-50*zoom} ${50-50*zoom}) scale(${zoom})`}>
      {compound.structure_2d.bonds.map((bond,index)=>{
        const a=byId.get(bond.a),b=byId.get(bond.b);if(!a||!b)return null;
        return <line key={index} x1={a.x} y1={a.y} x2={b.x} y2={b.y} className={bond.aromatic?'aromatic-bond':''} strokeWidth={bondStrokeWidth(bond.order)}><title>Bond {bond.a+1}–{bond.b+1} · order {bond.order}</title></line>;
      })}
      {atoms.map(atom=><g key={atom.id} className="chem-atom" onClick={()=>onSelect(atom.id)} tabIndex={0} role="button" aria-label={`Atom ${atom.id+1} ${atom.element}`}>
        <circle cx={atom.x} cy={atom.y} r={dense?2.15:2.8} className={ELEMENT_CLASS[atom.element]||'element-other'}/>
        {(!dense||atom.element!=='C'||atom.charge!==0)&&<text x={atom.x} y={atom.y+.85} className={ELEMENT_CLASS[atom.element]||'element-other'}>{atom.element}{atom.charge?atom.charge>0?`+${atom.charge}`:`${atom.charge}`:''}</text>}
        <title>Atom {atom.id+1} · {atom.element}{atom.charge?` · charge ${atom.charge}`:''}{atom.aromatic?' · aromatic':''}</title>
      </g>)}
    </g>
  </svg>;
}

function projectConformer(compound:MetaboliteStructure, frame:number, rotation:number, zoom:number, showHydrogens:boolean) {
  const conformers=compound.structure_3d.conformers;
  const conf=conformers[Math.min(frame,Math.max(0,conformers.length-1))];
  if(!conf)return {atoms:[] as Array<ChemicalAtom3D & {x:number;y:number;z:number;raw:[number,number,number]}>,bonds:[] as Array<{a:number;b:number;order:number}>};
  const visible = compound.structure_3d.atoms.filter(atom=>showHydrogens||atom.heavy);
  const visibleIds=new Set(visible.map(atom=>atom.id));
  const coords=visible.map(atom=>conf.coordinates[atom.id] as [number,number,number]);
  const center=coords.reduce((acc,[x,y,z])=>[acc[0]+x,acc[1]+y,acc[2]+z],[0,0,0]).map(v=>v/Math.max(1,coords.length)) as [number,number,number];
  const angle=rotation*Math.PI/180;
  const rotated=visible.map((atom,index)=>{
    const raw=coords[index];const x0=raw[0]-center[0],y0=raw[1]-center[1],z0=raw[2]-center[2];
    const x=x0*Math.cos(angle)+z0*Math.sin(angle);const z=-x0*Math.sin(angle)+z0*Math.cos(angle);
    const y=y0*Math.cos(.28)-z*Math.sin(.28);const z2=y0*Math.sin(.28)+z*Math.cos(.28);
    return {...atom,x,y,z:z2,raw};
  });
  const extent=Math.max(1,...rotated.flatMap(atom=>[Math.abs(atom.x),Math.abs(atom.y)]));
  const scale=(37/extent)*zoom;
  const atoms=rotated.map(atom=>({...atom,x:50+atom.x*scale,y:50-atom.y*scale}));
  return {atoms,bonds:compound.structure_3d.bonds.filter(b=>visibleIds.has(b.a)&&visibleIds.has(b.b))};
}

function Structure3D({compound,frame,rotation,zoom,showHydrogens,onSelect}:{compound:MetaboliteStructure;frame:number;rotation:number;zoom:number;showHydrogens:boolean;onSelect:(atom:number)=>void}) {
  const projected=useMemo(()=>projectConformer(compound,frame,rotation,zoom,showHydrogens),[compound,frame,rotation,zoom,showHydrogens]);
  const byId=new Map(projected.atoms.map(atom=>[atom.id,atom]));
  const sorted=[...projected.atoms].sort((a,b)=>a.z-b.z);
  return <svg className="chem-structure-svg chem-structure-3d" viewBox="0 0 100 100" role="img" aria-label={`${compound.name} projected 3D conformer`}>
    {projected.bonds.map((bond,index)=>{const a=byId.get(bond.a),b=byId.get(bond.b);if(!a||!b)return null;return <line key={index} x1={a.x} y1={a.y} x2={b.x} y2={b.y} strokeWidth={bondStrokeWidth(bond.order)*.65}><title>Bond {bond.a+1}–{bond.b+1}</title></line>})}
    {sorted.map(atom=><g key={atom.id} className="chem-atom" onClick={()=>onSelect(atom.id)} tabIndex={0} role="button" aria-label={`Atom ${atom.id+1} ${atom.element}`}>
      <circle cx={atom.x} cy={atom.y} r={(atom.element==='H'?1.05:2.2)+Math.max(-.3,Math.min(.6,atom.z*.04))} className={ELEMENT_CLASS[atom.element]||'element-other'}/>
      {atom.element!=='C'&&atom.element!=='H'&&<text x={atom.x} y={atom.y+.75}>{atom.element}</text>}
      <title>Atom {atom.id+1} · {atom.element} · x {atom.raw[0].toFixed(2)} · y {atom.raw[1].toFixed(2)} · z {atom.raw[2].toFixed(2)}</title>
    </g>)}
  </svg>;
}

function SpectrumPanel() {
  const max=Math.max(...SPECTRUM.map(point=>point[1]));
  return <div className="chem-spectrum-panel"><div className="chem-spectrum-bars">{SPECTRUM.map(([mz,intensity])=><span key={mz} style={{height:`${intensity/max*100}%`}} title={`m/z ${mz} · intensity ${intensity}`}><i>{intensity>=70?mz:''}</i></span>)}</div><div className="chem-spectrum-axis"><span>illustrative intensity</span><span>m/z →</span></div><p>This spectrum is preserved from the original teaching atlas. It is evidence-context only and is not claimed as a validated library spectrum for every selected molecule.</p></div>;
}

function IdentityPanel({compound}:{compound:MetaboliteStructure}) {
  return <div className="chem-identity-panel">
    <div className="chem-metrics">
      <span><b>{compound.formula}</b><small>formula</small></span>
      <span><b>{compound.monoisotopic_mass.toFixed(5)}</b><small>monoisotopic mass</small></span>
      <span><b>{compound.average_molecular_weight.toFixed(3)}</b><small>average MW</small></span>
      <span><b>{compound.tpsa.toFixed(1)}</b><small>TPSA Å²</small></span>
      <span><b>{compound.logp.toFixed(2)}</b><small>cLogP</small></span>
      <span><b>{compound.ring_count}</b><small>rings</small></span>
      <span><b>{compound.hbond_donors}/{compound.hbond_acceptors}</b><small>HBD / HBA</small></span>
      <span><b>{compound.formal_charge}</b><small>formal charge</small></span>
    </div>
    <div className="chem-detail-grid"><div><h4>Canonical SMILES</h4><code>{compound.canonical_smiles}</code></div><div><h4>Stereochemistry</h4><p>{compound.stereochemistry}</p></div></div>
    <div className="chem-chip-row">{compound.functional_groups.map(group=><span key={group}>{group}</span>)}</div>
    <div className="chem-element-counts">{Object.entries(compound.element_counts).map(([element,count])=><span key={element}><b>{element}</b>{count}</span>)}</div>
  </div>;
}

function IonPanel({compound}:{compound:MetaboliteStructure}) {
  const max=Math.max(...compound.isotope_envelope.map(p=>p.relative));
  return <div className="chem-ion-layout"><div><h4>Common teaching adducts</h4><div className="chem-adduct-grid">{compound.adducts.map(adduct=><span key={adduct.label}><b>{adduct.label}</b><code>{adduct.mz.toFixed(5)}</code><small>z {adduct.charge>0?'+':''}{adduct.charge}</small></span>)}</div></div><div><h4>Approximate isotope envelope</h4><div className="chem-isotope-chart">{compound.isotope_envelope.map(peak=><span key={peak.offset} style={{height:`${Math.max(3,peak.relative/max*100)}%`}}><i>M{peak.offset?`+${peak.offset}`:''}</i><small>{peak.mz.toFixed(4)}</small></span>)}</div><p>Teaching approximation dominated by ¹³C. It is not a complete isotope-distribution calculation.</p></div></div>;
}

function PathwayPanel({compound}:{compound:MetaboliteStructure}) {
  return <div className="chem-pathway-panel"><div className="chem-pathway-chain"><div><Atom/><b>{compound.name}</b><small>{compound.formula}</small></div><span>→</span><div><FlaskConical/><b>LC-MS feature</b><small>mass + adduct + RT</small></div><span>→</span>{compound.pathways.map(path=><div key={path}><Network/><b>{path}</b><small>biological context</small></div>)}</div><p>Pathway membership is contextual annotation. A detected m/z feature must be identified with appropriate analytical evidence before pathway conclusions are made.</p></div>;
}

export function MetabolomeStructureExplorer({candidateNames=[],compact=false}:{candidateNames?:string[];compact?:boolean}) {
  const [query,setQuery]=useState('');
  const [classFilter,setClassFilter]=useState('all');
  const [massMin,setMassMin]=useState(0);
  const [massMax,setMassMax]=useState(900);
  const [selectedId,setSelectedId]=useState('citrate');
  const [mode,setMode]=useState<ChemicalViewMode>('2d');
  const [zoom,setZoom]=useState(1);
  const [rotation,setRotation]=useState(25);
  const [showHydrogens,setShowHydrogens]=useState(false);
  const [frame,setFrame]=useState(0);
  const [playing,setPlaying]=useState(false);
  const [selectedAtom,setSelectedAtom]=useState<number|null>(null);
  const matchedCandidates=useMemo(()=>candidateSet(candidateNames),[candidateNames]);
  const classes=useMemo(()=>[...new Set(METABOLITE_STRUCTURES.map(m=>m.class))].sort(),[]);
  const filtered=useMemo(()=>METABOLITE_STRUCTURES.filter(m=>{
    const text=`${m.name} ${m.class} ${m.family} ${m.formula} ${m.functional_groups.join(' ')}`.toLowerCase();
    return (classFilter==='all'||m.class===classFilter)&&text.includes(query.toLowerCase())&&m.monoisotopic_mass>=massMin&&m.monoisotopic_mass<=massMax;
  }),[query,classFilter,massMin,massMax]);
  const compound=METABOLITE_STRUCTURES.find(m=>m.id===selectedId)??filtered[0]??METABOLITE_STRUCTURES[0];
  const conformers=compound.structure_3d.conformers;
  const frameSafe=Math.min(frame,Math.max(0,conformers.length-1));
  const selectedAtomData=compound.structure_3d.atoms.find(atom=>atom.id===selectedAtom)??compound.structure_2d.atoms.find(atom=>atom.id===selectedAtom);

  useEffect(()=>{setFrame(0);setSelectedAtom(null);setPlaying(false)},[compound.id]);
  useEffect(()=>{
    if(!playing||mode!=='4d'||conformers.length<2)return;
    const timer=window.setInterval(()=>setFrame(value=>(value+1)%conformers.length),700);
    return ()=>window.clearInterval(timer);
  },[playing,mode,conformers.length]);

  const currentRepresentation=METABOLOME_REPRESENTATIONS.find(item=>item.id===mode);
  return <section className={`metabolome-structure-explorer ${compact?'compact':''}`}>
    <header className="chem-explorer-header"><div><span className="data-eyebrow">CHEMICAL STRUCTURE WORKBENCH</span><h2>Metabolome & molecular structures</h2><p>Explore chemical identity → 2D connectivity → 3D conformers → 4D conformer ensembles → ions/isotopes → MS/MS evidence → pathway context.</p></div><span className="chem-library-badge">{METABOLITE_STRUCTURES.length} curated teaching molecules · extensible schema</span></header>

    {!compact&&<div className="chem-filter-bar">
      <label><span><Search size={13}/> Search</span><input value={query} onChange={e=>setQuery(e.target.value)} placeholder="citrate, lipid, C6H8O7…"/></label>
      <label><span>Structure class</span><select value={classFilter} onChange={e=>setClassFilter(e.target.value)}><option value="all">All classes</option>{classes.map(item=><option key={item}>{item}</option>)}</select></label>
      <label><span>Exact mass min</span><input type="number" min="0" value={massMin} onChange={e=>setMassMin(Math.max(0,Number(e.target.value)||0))}/></label>
      <label><span>Exact mass max</span><input type="number" min="0" value={massMax} onChange={e=>setMassMax(Math.max(0,Number(e.target.value)||0))}/></label>
    </div>}

    <div className="chem-browser-layout">
      <aside className="chem-compound-list" aria-label="Metabolite structures">
        <div className="chem-list-summary"><b>{filtered.length}</b><span>structures in current filter</span></div>
        {filtered.map(item=>{const matched=[item.name,item.id,...item.functional_groups].some(value=>matchedCandidates.has(value.toLowerCase()))||candidateNames.some(candidate=>item.name.toLowerCase().includes(candidate.toLowerCase())||candidate.toLowerCase().includes(item.id));return <button key={item.id} className={compound.id===item.id?'active':''} onClick={()=>setSelectedId(item.id)}><span><strong>{item.name}</strong><small>{item.family} · {item.formula}</small></span><i>{item.monoisotopic_mass.toFixed(2)} Da</i>{matched&&<em>dataset match</em>}</button>})}
        {!filtered.length&&<p>No structures match the current class, search and mass range.</p>}
      </aside>

      <div className="chem-workbench">
        <div className="chem-compound-heading"><div><span>{compound.class}</span><h3>{compound.name}</h3><p>{compound.description}</p></div><div className="chem-formula"><b>{compound.formula}</b><small>{compound.monoisotopic_mass.toFixed(5)} Da</small></div></div>
        <nav className="chem-view-tabs" aria-label="Chemical representation level">{(Object.keys(VIEW_LABELS) as ChemicalViewMode[]).map(view=>{const Icon=VIEW_ICONS[view];return <button key={view} className={mode===view?'active':''} onClick={()=>setMode(view)}><Icon size={14}/><span>{VIEW_LABELS[view]}</span></button>})}</nav>
        {currentRepresentation&&<div className="chem-representation-note"><strong>{currentRepresentation.label}</strong><span>{currentRepresentation.detail}</span></div>}

        {(mode==='2d'||mode==='3d'||mode==='4d')&&<div className="chem-structure-controls">
          <label>Zoom <input type="range" min="0.65" max="2.2" step="0.05" value={zoom} onChange={e=>setZoom(Number(e.target.value))}/><span>{zoom.toFixed(2)}×</span></label>
          {(mode==='3d'||mode==='4d')&&<><label>Rotation <input type="range" min="0" max="360" value={rotation} onChange={e=>setRotation(Number(e.target.value))}/><span>{rotation}°</span></label><label className="chem-checkbox"><input type="checkbox" checked={showHydrogens} onChange={e=>setShowHydrogens(e.target.checked)}/><span>Show H atoms</span></label></>}
          {mode==='4d'&&<div className="chem-frame-control"><button disabled={conformers.length<2} onClick={()=>setPlaying(v=>!v)}>{playing?<Pause size={14}/>:<Play size={14}/>} {playing?'Pause':'Play'}</button><label>Conformer <input type="range" min="0" max={Math.max(0,conformers.length-1)} value={frameSafe} onChange={e=>setFrame(Number(e.target.value))}/><span>{conformers.length?frameSafe+1:0}/{conformers.length}</span></label></div>}
        </div>}

        <div className={`chem-stage mode-${mode}`}>
          {mode==='1d'&&<IdentityPanel compound={compound}/>} 
          {mode==='2d'&&<Structure2D compound={compound} zoom={zoom} onSelect={setSelectedAtom}/>} 
          {(mode==='3d'||mode==='4d')&&<><Structure3D compound={compound} frame={frameSafe} rotation={rotation} zoom={zoom} showHydrogens={showHydrogens} onSelect={setSelectedAtom}/>{mode==='4d'&&<div className="chem-science-warning">4D here means a conformer-frame dimension. These frames are RDKit teaching conformers, not molecular-dynamics time steps.</div>}</>}
          {mode==='ions'&&<IonPanel compound={compound}/>} 
          {mode==='msms'&&<SpectrumPanel/>} 
          {mode==='pathway'&&<PathwayPanel compound={compound}/>} 
        </div>

        <footer className="chem-detail-footer"><div><strong>Functional groups</strong><span>{compound.functional_groups.join(' · ')}</span></div><div><strong>Structure facts</strong><span>{compound.structure_2d.atoms.length} heavy atoms · {compound.structure_2d.bonds.length} heavy-atom bonds · {compound.ring_count} ring(s) · {conformers.length} generated conformer frame(s)</span></div>{selectedAtomData&&<div><strong>Selected atom</strong><span>#{selectedAtomData.id+1} · {selectedAtomData.element} · formal charge {selectedAtomData.charge}</span></div>}</footer>
      </div>
    </div>

    {!compact&&<details className="chem-capability-details"><summary>Supported chemical structure levels and future data-lake formats</summary><div className="chem-capability-grid"><div><h3>Representation layers</h3>{METABOLOME_REPRESENTATIONS.map(item=><p key={item.id}><b>{item.label}</b><span>{item.detail}</span></p>)}</div><div><h3>Future import/storage formats</h3>{METABOLOME_IMPORT_FORMATS.map(item=><p key={item.format}><b>{item.format}</b><span>{item.purpose}</span></p>)}</div></div><h3>Scientific boundaries</h3><ul>{METABOLOME_SCIENTIFIC_BOUNDARIES.map(note=><li key={note}>{note}</li>)}</ul></details>}
  </section>;
}
